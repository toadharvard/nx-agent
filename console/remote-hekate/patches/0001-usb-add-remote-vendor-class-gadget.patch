From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nx-agent contributors <nx-agent@users.noreply.github.com>
Date: Fri, 16 Oct 2026 00:00:00 +0000
Subject: [PATCH 1/3] usb: add remote vendor-class gadget

Add USB_GADGET_REMOTE: a vendor-class (0xFF/0x52/0x01) clone of the UMS
descriptors with PID 0xA7E1 on hekate's VID 0x11EC, built in separate
static storage so the UMS descriptors are never mutated. 0xA7E1 is also
the PID of hekate's HID gamepad gadget; hosts identify the remote
interface by its class triple, not by VID:PID alone.

Split xusb_device_enumerate() into xusb_device_enumerate_begin(), which
prepares the controller without waiting for the host, and the original
blocking loop. xusb_remote_configured() runs one bounded EP operation
step so the Nyx GUI loop can poll enumeration without blocking.

HID-only control paths now match the two HID gadgets explicitly instead
of "gadget >= USB_GADGET_HID_GAMEPAD", so the new gadget id is not
treated as HID.
---
 bdk/usb/usb_descriptors.c | 16 ++++++++++++++++
 bdk/usb/usbd.h            |  3 +++
 bdk/usb/xusbd.c           | 28 ++++++++++++++++++++++++----
 3 files changed, 43 insertions(+), 4 deletions(-)

diff --git a/bdk/usb/usb_descriptors.c b/bdk/usb/usb_descriptors.c
index 04346d9..cb3ea63 100644
--- a/bdk/usb/usb_descriptors.c
+++ b/bdk/usb/usb_descriptors.c
@@ -540,3 +540,19 @@ usb_desc_t usb_gadget_hid_touch_descriptors =
 	.ms_cid    = &usb_ms_cid_descriptor,
 	.mx_ext    = &usb_ms_ext_prop_descriptor_hid
 };
+
+/* Independent vendor-class clone: never mutate the UMS descriptors. */
+static usb_dev_descr_t remote_dev;
+static usb_cfg_simple_descr_t remote_cfg,remote_other;
+usb_desc_t usb_gadget_remote_descriptors;
+void usb_remote_descriptors_init(void)
+{
+ remote_dev=usb_device_descriptor_ums;remote_dev.idProduct=0xA7E1;
+ remote_cfg=usb_configuration_descriptor_ums;remote_other=usb_other_speed_config_descriptor_ums;
+ remote_cfg.interface.bInterfaceClass=0xff;remote_cfg.interface.bInterfaceSubClass=0x52;remote_cfg.interface.bInterfaceProtocol=1;
+ remote_other.interface=remote_cfg.interface;
+ usb_gadget_remote_descriptors=usb_gadget_ums_descriptors;
+ usb_gadget_remote_descriptors.dev=&remote_dev;
+ usb_gadget_remote_descriptors.cfg=&remote_cfg;
+ usb_gadget_remote_descriptors.cfg_other=&remote_other;
+}
diff --git a/bdk/usb/usbd.h b/bdk/usb/usbd.h
index 3895a9c..096e26b 100644
--- a/bdk/usb/usbd.h
+++ b/bdk/usb/usbd.h
@@ -48,6 +48,7 @@ typedef enum _usb_gadget_type
 	USB_GADGET_UMS          = 0,
 	USB_GADGET_HID_GAMEPAD  = 1,
 	USB_GADGET_HID_TOUCHPAD = 2,
+	USB_GADGET_REMOTE       = 3,
 } usb_gadget_type;
 
 typedef enum {
@@ -208,6 +209,8 @@ typedef struct _usb_ctxt_t
 
 void usb_device_get_ops(usb_ops_t *ops);
 void xusb_device_get_ops(usb_ops_t *ops);
+int xusb_device_enumerate_begin(usb_gadget_type gadget);
+bool xusb_remote_configured(void);
 
 int  usb_device_gadget_ums(usb_ctxt_t *usbs);
 int  usb_device_gadget_hid(usb_ctxt_t *usbs);
diff --git a/bdk/usb/xusbd.c b/bdk/usb/xusbd.c
index a4a47e6..e608be5 100644
--- a/bdk/usb/xusbd.c
+++ b/bdk/usb/xusbd.c
@@ -395,6 +395,8 @@ extern u8 hid_report_descriptor_touch[];
 extern usb_desc_t usb_gadget_hid_jc_descriptors;
 extern usb_desc_t usb_gadget_hid_touch_descriptors;
 extern usb_desc_t usb_gadget_ums_descriptors;
+extern usb_desc_t usb_gadget_remote_descriptors;
+void usb_remote_descriptors_init(void);
 
 // All rings and EP context must be aligned to 0x10.
 typedef struct _xusbd_event_queues_t
@@ -1541,7 +1543,7 @@ static int _xusb_handle_get_descriptor(const usb_ctrl_setup_t *ctrl_setup)
 		break;
 	case USB_DESCRIPTOR_CONFIGURATION:
 		//! TODO USB3: Provide a super speed descriptor.
-		if (usbd_xotg->gadget == USB_GADGET_UMS)
+		if ((usbd_xotg->gadget == USB_GADGET_UMS || usbd_xotg->gadget == USB_GADGET_REMOTE))
 		{
 			if (usbd_xotg->port_speed == XUSB_HIGH_SPEED) // High speed. 512 bytes.
 			{
@@ -1799,7 +1801,7 @@ static int _xusbd_handle_ep0_control_transfer(usb_ctrl_setup_t *ctrl_setup)
 			size = sizeof(xusb_status_descriptor);
 			transmit_data = true;
 		}
-		else if (_bRequest == USB_REQUEST_GET_DESCRIPTOR && (_wValue >> 8) == USB_DESCRIPTOR_HID_REPORT && usbd_xotg->gadget >= USB_GADGET_HID_GAMEPAD)
+		else if (_bRequest == USB_REQUEST_GET_DESCRIPTOR && (_wValue >> 8) == USB_DESCRIPTOR_HID_REPORT && (usbd_xotg->gadget == USB_GADGET_HID_GAMEPAD || usbd_xotg->gadget == USB_GADGET_HID_TOUCHPAD))
 		{
 			if (usbd_xotg->gadget == USB_GADGET_HID_GAMEPAD)
 			{
@@ -1961,10 +1963,14 @@ static int _xusb_ep_operation(u32 tries)
 	return res;
 }
 
-int xusb_device_enumerate(usb_gadget_type gadget)
+int xusb_device_enumerate_begin(usb_gadget_type gadget)
 {
 	switch (gadget)
 	{
+	case USB_GADGET_REMOTE:
+		usb_remote_descriptors_init();
+		usbd_xotg->desc = &usb_gadget_remote_descriptors;
+		break;
 	case USB_GADGET_UMS:
 		usbd_xotg->desc = &usb_gadget_ums_descriptors;
 		break;
@@ -2012,6 +2018,20 @@ int xusb_device_enumerate(usb_gadget_type gadget)
 	usbd_xotg->wait_for_event_trb = XUSB_TRB_SETUP;
 	usbd_xotg->device_state       = XUSB_DEFAULT;
 
+ return USB_RES_OK;
+}
+
+bool xusb_remote_configured(void)
+{
+ _xusb_ep_operation(1);
+ return usbd_xotg->device_state == XUSB_CONFIGURED;
+}
+
+int xusb_device_enumerate(usb_gadget_type gadget)
+{
+ int prepare=xusb_device_enumerate_begin(gadget);
+ if(prepare)return prepare;
+
 	// Timeout if cable or communication isn't started in 1.5 minutes.
 	u32 timer = get_tmr_ms() + 90000;
 	while (true)
@@ -2048,7 +2068,7 @@ int xusb_handle_ep0_ctrl_setup(u32 *data)
 	 * EP0 Control handling is done by normal ep operation in XUSB.
 	 * Here we handle the interface only, except if HID.
 	 */
-	if (usbd_xotg->gadget >= USB_GADGET_HID_GAMEPAD)
+	if ((usbd_xotg->gadget == USB_GADGET_HID_GAMEPAD || usbd_xotg->gadget == USB_GADGET_HID_TOUCHPAD))
 		_xusb_ep_operation(1);
 
 	if (usbd_xotg->intr_idle_req)

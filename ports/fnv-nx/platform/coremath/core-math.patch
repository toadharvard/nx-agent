 #define MASK 0x7fffffffffffffffull // 2^63-1 (mask the sign bit)
 
+/* Last step of Ziv's strategy: atan2(y,x) correctly rounded in the current rounding mode, by MPFR at 53 bits (tint_tod could not decide the rounding).
+   The exponent range of MPFR is set to binary64's for the call and mpfr_subnormalize rounds a subnormal result once. */
+static double
+atan2_mpfr (double y, double x)
+{
+  mpfr_rnd_t rnd;
+  switch (fegetround ())
+    {
+    case FE_TONEAREST: rnd = MPFR_RNDN; break;
+    case FE_TOWARDZERO: rnd = MPFR_RNDZ; break;
+    case FE_UPWARD: rnd = MPFR_RNDU; break;
+    default: rnd = MPFR_RNDD; break; /* FE_DOWNWARD: the four rounding modes of <fenv.h> on this target are these */
+    }
+  mpfr_exp_t emin = mpfr_get_emin (), emax = mpfr_get_emax ();
+  mpfr_set_emin (-1073);
+  mpfr_set_emax (1024);
+  mpfr_t Y, X, R;
+  mpfr_init2 (Y, 53);
+  mpfr_init2 (X, 53);
+  mpfr_init2 (R, 53);
+  mpfr_set_d (Y, y, MPFR_RNDN); /* exact */
+  mpfr_set_d (X, x, MPFR_RNDN); /* exact */
+  int t = mpfr_atan2 (R, Y, X, rnd);
+  mpfr_subnormalize (R, t, rnd);
+  double r = mpfr_get_d (R, rnd);
+  mpfr_clear (Y);
+  mpfr_clear (X);
+  mpfr_clear (R);
+  mpfr_set_emin (emin);
+  mpfr_set_emax (emax);
+  return r;
+}

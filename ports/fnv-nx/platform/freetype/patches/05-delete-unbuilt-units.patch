-          for ( nn = 0; nn < num_hints; nn++ )
-          {
-            PSH_Hint  hint = sort[nn];
-
-
-            if ( org_u >=          hint->org_pos                  &&
-                 org_u <= ADD_INT( hint->org_pos, hint->org_len ) )

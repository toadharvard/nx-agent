-
-    OTV_TRACE(( " (Count = %d)\n", Count ));
-
-    OTV_LIMIT_CHECK( Count * otvalid->extra1 * 2 );
-
-    table_size = Count * otvalid->extra1 * 2 + 2;
-
-    for ( ; Count > 0; Count-- )

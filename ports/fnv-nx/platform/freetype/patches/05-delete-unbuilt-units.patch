-      {
-        AF_LatinBlue  blue = &axis->blues[nn];
-
-
-        FT_TRACE5(( "  reference %d: %ld scaled to %.2f%s\n",
-                    nn,
-                    blue->ref.org,
-                    (double)blue->ref.fit / 64,
-                    ( blue->flags & AF_LATIN_BLUE_ACTIVE ) ? ""
-                                                           : " (inactive)" ));
-        FT_TRACE5(( "  overshoot %d: %ld scaled to %.2f%s\n",
-                    nn,
-                    blue->shoot.org,
-                    (double)blue->shoot.fit / 64,
-                    ( blue->flags & AF_LATIN_BLUE_ACTIVE ) ? ""
-                                                           : " (inactive)" ));
-      }
-#endif
-    }
-  }

-  static int
-  af_get_edge_index( AF_GlyphHints  hints,
-                     int            segment_idx,
-                     int            dimension )
-  {
-    AF_AxisHints  axis    = &hints->axis[dimension];
-    AF_Edge       edges   = axis->edges;
-    AF_Segment    segment = axis->segments + segment_idx;

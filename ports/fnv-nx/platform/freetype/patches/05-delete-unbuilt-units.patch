-    if ( num_coords > blend->num_axis )
-    {
-      FT_TRACE2(( "T1_Get_MM_Blend: only using first %d of %d coordinates\n",
-                  blend->num_axis, num_coords ));
-      nc = blend->num_axis;
-    }
-
-    for ( i = 0; i < nc; i++ )
-      coords[i] = axiscoords[i];
-    for ( ; i < num_coords; i++ )
-      coords[i] = 0x8000;
-
-    return FT_Err_Ok;

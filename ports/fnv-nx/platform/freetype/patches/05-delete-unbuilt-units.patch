-#define SVG_DOCUMENT_RECORD_SIZE        (12U)
-#define SVG_DOCUMENT_LIST_MINIMUM_SIZE  (2U + SVG_DOCUMENT_RECORD_SIZE)
-#define SVG_MINIMUM_SIZE                (SVG_TABLE_HEADER_SIZE +        \

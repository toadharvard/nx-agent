-      case 3: *q++ = (unsigned char)s; FALL_THROUGH; \
-      case 2: *q++ = (unsigned char)s; FALL_THROUGH; \
-      case 1: *q   = (unsigned char)s; FALL_THROUGH; \
-      case 0: break;                                 \
-      default: FT_MEM_SET( d, s, count );            \
-    }                                                \
-  FT_END_STMNT

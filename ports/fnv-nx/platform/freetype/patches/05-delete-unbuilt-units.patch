-  {
-    FT_ASSERT( decoder );
-    FT_ASSERT( !decoder->builder.is_t1 );
-
-    decoder->free_glyph_callback( (TT_Face)decoder->builder.face,
-                                  (FT_Byte**)&buf->start,
-                                  (FT_ULong)( buf->end - buf->start ) );
-  }

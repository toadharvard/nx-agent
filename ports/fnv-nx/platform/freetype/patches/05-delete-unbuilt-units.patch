-    FT_Memory  memory = face->root.memory;
-
-    FT_ULong  table_size;
-    FT_Byte*  table = NULL;
-    FT_Byte*  p     = NULL;
-    Svg*      svg   = NULL;
-    FT_ULong  offsetToSVGDocumentList;
-
-
-    error = face->goto_table( face, TTAG_SVG, stream, &table_size );
-    if ( error )
-      goto NoSVG;
-
-    if ( table_size < SVG_MINIMUM_SIZE )
-      goto InvalidTable;

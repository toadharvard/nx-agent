-      GXV_TRACE(( "  [odd] the first glyph is marked as dontAdvance"
-                  " in Indic rearrangement\n" ));
-      GXV_SET_ERR_IF_PARANOID( FT_INVALID_DATA );
-    }
-
-    if ( 0 < reserved )
-    {
-      GXV_TRACE(( " non-zero bits found in reserved range\n" ));
-      GXV_SET_ERR_IF_PARANOID( FT_INVALID_DATA );
-    }
-    else
-      GXV_TRACE(( "\n" ));
-  }

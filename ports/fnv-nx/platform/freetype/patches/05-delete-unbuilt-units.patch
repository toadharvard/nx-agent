-  /* An auxiliary function for overflow-safe addition. */
-  static FT_Int
-  safe_int_addition( FT_Int   a,
-                     FT_Int   b,
-                     FT_Int*  result )
-  {
-    if ( ( ( a > 0 ) && ( b > FT_INT_MAX - a ) ) ||
-         ( ( a < 0 ) && ( b < FT_INT_MIN - a ) ) )
-      return FT_THROW( Invalid_Table );
-
-    *result = a + b;
-    return FT_Err_Ok;

-
-    if ( p >= limit )
-      goto Bad;
-
-    if ( *p == '-' || *p == '+' )
-    {
-      sign = FT_BOOL( *p == '-' );
-
-      p++;
-      if ( p == limit )
-        goto Bad;
-
-      /* only a single sign is allowed */
-      if ( *p == '-' || *p == '+' )
-        return 0;
-    }

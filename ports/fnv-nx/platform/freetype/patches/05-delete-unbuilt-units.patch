-
-  /**************************************************************************
-   *
-   * @Function:
-   *   tt_done_blend
-   *
-   * @Description:
-   *   Free the blend internal data structure.
-   */
-  FT_LOCAL_DEF( void )
-  tt_done_blend( FT_Face  face )
-  {
-    TT_Face    ttface = (TT_Face)face;
-    FT_Memory  memory = FT_FACE_MEMORY( face );

-        (FT_UShort*)( (char*)mmvar + mmvar_size );
-      mmvar->axis =
-        (FT_Var_Axis*)( (char*)axis_flags + axis_flags_size );
-      mmvar->namedstyle =
-        (FT_Var_Named_Style*)( (char*)mmvar->axis + axis_size );
-
-      next_coords = (FT_Fixed*)( (char*)mmvar->namedstyle +
-                                 namedstyle_size );
-      for ( i = 0; i < num_instances; i++ )

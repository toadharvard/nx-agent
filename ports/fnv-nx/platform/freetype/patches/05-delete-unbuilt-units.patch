-  static void
-  compute_bbox( FT_ULong           n_points,
-                const WOFF2_Point  points,
-                FT_Byte*           dst,
-                FT_UShort*         src_x_min )
-  {
-    FT_Int  x_min = 0;
-    FT_Int  y_min = 0;
-    FT_Int  x_max = 0;
-    FT_Int  y_max = 0;

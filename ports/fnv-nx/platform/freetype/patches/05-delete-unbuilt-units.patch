-
-  static FT_Int
-  compare_svg_doc( Svg_doc  doc,
-                   FT_UInt  glyph_index )
-  {
-    if ( glyph_index < doc.start_glyph_id )
-      return -1;
-    else if ( glyph_index > doc.end_glyph_id )
-      return 1;
-    else
-      return 0;
-  }

-    aA.y = FT_26D6_16D16( aA.y );
-
-    bB.x = FT_26D6_16D16( bB.x );
-    bB.y = FT_26D6_16D16( bB.y );
-
-    p0.x = FT_26D6_16D16( p0.x );
-    p0.y = FT_26D6_16D16( p0.y );
-
-    p.x = FT_26D6_16D16( p.x );
-    p.y = FT_26D6_16D16( p.y );

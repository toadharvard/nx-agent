-#ifdef _MSC_VER
-// shitty msvc compatbility
-// meson gives us sane paths (separated by '/') while on MSVC,
-// __FILE__ contains a '\\' separator.
-static bool path_same(char a, char b) {
-	return (a == b) ||
-		(a == '/' && b == '\\') ||
-		(a == '\\' && b == '/');
-}
-#else
-
-static inline bool path_same(char a, char b) {
-	return a == b;
-}
-
-#endif

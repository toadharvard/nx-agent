-    FT_Long          size;
-    FT_Long          nodes;
-    FT_MemNode*      buckets;
-
-    FT_Long          alloc_total;
-    FT_Long          alloc_current;
-    FT_Long          alloc_max;
-    FT_Long          alloc_count;
-
-    FT_Bool          bound_total;
-    FT_Long          alloc_total_max;
-
-    FT_Bool          bound_count;
-    FT_Long          alloc_count_max;
-
-    FT_MemSource     sources[FT_MEM_SOURCE_BUCKETS];
-
-    FT_Bool          keep_alive;

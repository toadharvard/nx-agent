-  /* later for the even-odd rule.                                   */
-#define FT_FILL_RULE( coverage, area, fill )                \
-  FT_BEGIN_STMNT                                            \
-    coverage = (int)( area >> ( PIXEL_BITS * 2 + 1 - 8 ) ); \
-    if ( coverage & fill )                                  \
-      coverage = ~coverage;                                 \
-    if ( coverage > 255 && fill & INT_MIN )                 \

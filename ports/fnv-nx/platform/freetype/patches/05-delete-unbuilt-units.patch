-bool dlg_remove_tag(const char* tag, const char* func) {
-	struct dlg_data* data = dlg_data();
-	for(unsigned int i = 0; i < vec_size(data->pairs); ++i) {
-		if(data->pairs[i].func == func && data->pairs[i].tag == tag) {
-			vec_erase(data->pairs, i);
-			return true;

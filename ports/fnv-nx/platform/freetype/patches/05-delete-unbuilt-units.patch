-  static void
-  abort_test( int  sig )
-  {
-    FT_UNUSED( sig );
-
-    /* If a time-out happens, then kill the child */
-    kill( child_pid, SIGFPE );
-    write( 2, "Timeout... ", 11 );
-  }

-  static Svg_doc
-  extract_svg_doc( FT_Byte*  stream )
-  {
-    Svg_doc  doc;
-
-
-    doc.start_glyph_id = FT_NEXT_USHORT( stream );
-    doc.end_glyph_id   = FT_NEXT_USHORT( stream );
-
-    doc.offset = FT_NEXT_ULONG( stream );
-    doc.length = FT_NEXT_ULONG( stream );
-
-    return doc;

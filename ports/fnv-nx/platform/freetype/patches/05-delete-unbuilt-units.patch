-  /* An auxiliary function for overflow-safe addition. */
-  static FT_Int
-  with_sign( FT_Byte  flag,
-             FT_Int   base_val )
-  {
-    /* Precondition: 0 <= base_val < 65536 (to avoid overflow). */

#!/usr/bin/env python3
"""Stand-in for devkitPro's bin2s (general-tools), enough for libnx and the devkitA64 bin2o rule:

    bin2s [-a ALIGN] [-H header.h] file... > out.s

Emits <name> / <name>_end / <name>_size symbols (name = file name with '.' -> '_') in .rodata.<name>.
"""
import argparse
import os
import re
import sys

ap = argparse.ArgumentParser()
ap.add_argument("-a", "--alignment", type=int, default=4)
ap.add_argument("-H", "--header")
ap.add_argument("files", nargs="+")
a = ap.parse_args()

out = sys.stdout
hdr = ["/* Generated by bin2s (fnv-nx stand-in) */", "#pragma once", "#include <stddef.h>", "#include <stdint.h>"]
for path in a.files:
    data = open(path, "rb").read()
    sym = re.sub(r"[^0-9A-Za-z_]", "_", os.path.basename(path))
    if sym[0].isdigit():
        sym = "_" + sym
    out.write(f"\t.section .rodata.{sym}, \"a\"\n\t.balign {a.alignment}\n\t.global {sym}\n{sym}:\n")
    for i in range(0, len(data), 16):
        out.write("\t.byte " + ",".join(str(b) for b in data[i:i + 16]) + "\n")
    out.write(f"\n\t.global {sym}_end\n{sym}_end:\n\t.balign 4\n\t.global {sym}_size\n{sym}_size: .int {len(data)}\n\n")
    hdr += [f"extern const uint8_t {sym}_end[];", f"extern const uint8_t {sym}[];",
            f"extern const uint32_t {sym}_size;"]
if a.header:
    with open(a.header, "w") as f:
        f.write("\n".join(hdr) + "\n")

%rename link                old_link

*link:
%(old_link) -T %:getenv(FNVNX_TOOLCHAIN /../link/guest.ld) -pie --no-dynamic-linker -z text -z now -z pack-relative-relocs -z max-page-size=0x1000 --build-id=sha1 --require-defined=__fnvnx_guest_start --require-defined=main

*startfile:
crti%O%s crtbegin%O%s

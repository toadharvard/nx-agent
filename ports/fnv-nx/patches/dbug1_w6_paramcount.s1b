# DBUG1 (stream S2-bodies, worker W6, EQ fuzz row param-count 0x00d32b40) - a cdecl callback whose declaration has three
# int parameters while the x86 code reads five stack words (docs/PATCHES.md "DBUG1").

@@ DBUG1 src/havok/physics/collide/agent3/convexlist3/hkpconvexlistagent3.cpp file
# x86 0x00d32b40 (a slot of the agent function table that 0x00d33140 fills, cdecl, plain `ret`): reads the word at
# [esp+8] (the object; its byte at +0xb is tested against 0x20), then the words at [esp+0xc] and [esp+0x10] as x87
# floats (fld, fstp into the argument area of the call) and the word at [esp+0x14] as an integer (push). It calls
# 0x00da35f0 with four stack words: the object + 0x10, the float from +0xc, the float from +0x10 and the integer from
# +0x14, then pops those four itself (add esp, 0x10). The word at [esp+4] is never read. So the
# function has five parameters: an unused first word, the object, two floats and an integer; the neighbouring table
# entry 0x00d34d80 (hkpcollectioncollectionagent3.cpp) is declared with the same five. The decomp declared three ints
# and reached the other three words through the address of the second parameter, which on the target (arguments in
# registers) reads past the spilled parameters. The function is only stored into the table, never called by name, so
# only its declaration (written twice) changes; its recipe name becomes ?FUN_00d32b40@@YAXHPAXMMH@Z (units_renames.tsv).
<<<
void __cdecl FUN_00d32b40(int, int, int);
===
void __cdecl FUN_00d32b40(int, void*, float, float, int);
>>>
<<<
void __cdecl FUN_00d32b40(int aiUnused, int aiArg1, int aiArg2)
{
    struct StackArguments
    {
        void* object;
        float first;
        float second;
        int third;
    };

    StackArguments* pStackArgs = reinterpret_cast<StackArguments*>(&aiArg1);
    if (!(reinterpret_cast<unsigned char*>(pStackArgs->object)[0xb] & 0x20))
    {
        _FUN_00da35f0(reinterpret_cast<unsigned char*>(pStackArgs->object) + 0x10, pStackArgs->first,
                      pStackArgs->second, pStackArgs->third);
    }
}

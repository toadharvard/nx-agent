struct FUN_00e5c670_s1b { void* FUN_00e5c540(void*, void*); void* FUN_00e5c670(void* apArg); }; /* fnv-nx XINC1: 0x00e5c540 Registry_e5c5::FUN_00e5c540 */ void* FUN_00e5c670_s1b::FUN_00e5c670(void* apArg)
{

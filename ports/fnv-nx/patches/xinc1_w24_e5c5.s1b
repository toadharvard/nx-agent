# XINC1 (stream S2-bodies, worker W24, EQ fuzz row 0x00e5c8b0) - the three remaining forwarders of 0x00e5c540 that the
# decomp declares as free stdcall functions calling a free stdcall 0x00e5c540 (docs/PATCHES.md "XINC1"; the siblings
# 0x00e5c5b0, 0x00e5c630, 0x00e5c650 and 0x00e5c690 are in xinc1_r3_staging.s1b).
#
# x86 0x00e5c540 is a member of the registry: `ret 8`, but it never writes ecx before `call 0x00e5c4d0` (mov esi, ecx; it
# reads [esi+4], the registry's table), so ecx = the registry is read through that callee and the decomp's definition
# (Registry_e5c5, `this` forwarded to FUN_00e5c4d0) is right. The forwarders below push (name, global) and call it with
# the ecx they were entered with (`mov eax,[esp+4]; push G; push eax; call 0x00e5c540; ret 4`, ecx untouched), i.e. they
# are thiscall members too, and they return its eax (0x00e5c8b0 calls 0x00e5c610 and 0x00e5c5f0 with ecx = its own
# object and tests eax). The decomp declared them free with no result: natively the callee got (name, global, garbage)
# for (this, name, expected) and the callers' this went in the first slot. Now members of a shell, as the siblings, and
# returning the callee's result (void*); the new decorations are in units_renames.tsv.

@@ XINC1 src/staging/blk_00e40000_o2.cpp 0x00e5c5f0
# x86 0x00e5c5f0 (stdcall, ret 4): ecx is never written before the call of 0x00e5c540 (see the head of this file); a
# thiscall member with the callee's result.
<<<
void __stdcall FUN_00e5c5f0(int aiValue)
{
    FUN_00e5c540(aiValue, (int)&g_0126c5f0);
===
struct FUN_00e5c5f0_s1b { void* FUN_00e5c540(int, int); void* FUN_00e5c5f0(int aiValue); }; /* fnv-nx XINC1: 0x00e5c540 Registry_e5c5::FUN_00e5c540 */ void* FUN_00e5c5f0_s1b::FUN_00e5c5f0(int aiValue)
{
    return FUN_00e5c540(aiValue, (int)&g_0126c5f0);
>>>

@@ XINC1 src/staging/blk_00e40000_o2.cpp 0x00e5c610
# x86 0x00e5c610 (stdcall, ret 4): as 0x00e5c5f0, with the global at 0x0126e570.
<<<
void __stdcall FUN_00e5c610(int aiValue)
{
    FUN_00e5c540(aiValue, &g_0126e570);
===
struct FUN_00e5c610_s1b { void* FUN_00e5c540(int, struct fnv_00e5c610::GlobalObjectO2_00d472a0 *); void* FUN_00e5c610(int aiValue); }; /* fnv-nx XINC1: 0x00e5c540 Registry_e5c5::FUN_00e5c540 */ void* FUN_00e5c610_s1b::FUN_00e5c610(int aiValue)
{
    return FUN_00e5c540(aiValue, &g_0126e570);
>>>

@@ XINC1 src/staging/blk_00e40000_o2.cpp 0x00e5c670
# x86 0x00e5c670 (stdcall, ret 4): as 0x00e5c5f0, with the global at 0x0126ea80; it already returned void*.
<<<

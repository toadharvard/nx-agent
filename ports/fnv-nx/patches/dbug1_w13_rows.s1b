# DBUG1 (stream S2-bodies, worker W13): two declarations that disagree with the x86 code, from EQ fuzz rows 0x0087a790 and
# 0x007e6620 (docs/PATCHES.md "DBUG1").

@@ DBUG1 src/fallout/misc/garbagecollector_packet.h file
# x86 0x0040fc90 (GarbageCollector::QueryCurrentThread, the thread-id getter every caller reaches as
# gm_GetCurrentThreadId): `push ebp; mov ebp,esp; call [GetCurrentThreadId]; pop ebp; ret` - a plain `ret` (no stack
# word is popped or read) and eax, GetCurrentThreadId's result, is the return value. The decomp declared it
# `static void (bool)`: an argument the callers never push and a result they do read (0x0087a790 stores it).
# Now a static member returning unsigned long (units_renames.tsv: def and ref).
<<<
    static void QueryCurrentThread(bool);
===
    static unsigned long QueryCurrentThread();
>>>

@@ DBUG1 src/fallout/misc/garbagecollector.cpp file
# x86 0x0040fc90: see garbagecollector_packet.h in this patch; the body returns GetCurrentThreadId()'s result (eax).
<<<
void GarbageCollector::QueryCurrentThread(bool)
{
    GetCurrentThreadId();
}
===
unsigned long GarbageCollector::QueryCurrentThread()
{
    return GetCurrentThreadId();
}
>>>

@@ DBUG1 src/fallout/interface/interfacemanager.cpp file
# x86 0x007e6620 (HandleTileClick) tests the byte that 0x00716ae0 returns (`mov al,[ecx+0x21]`, not normalised) with
# `movzx ecx,al; test ecx,ecx; je`: any nonzero byte counts. The decomp declared that callee's result as bool, and GCC
# tests only bit 0 of a bool result (tbnz w0,#0), so an even nonzero byte (0x02, 0x80) takes the false branch natively
# (return 0 before the 3 calls the x86 code makes). An unsigned char result compiles to the same MSVC test (movzx;
# test); the neighbouring caller of the same callee already casts to unsigned char.
<<<
    bool GetByteAtOffset33();
===
    unsigned char GetByteAtOffset33();
>>>

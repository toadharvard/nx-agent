# RET1 - non-void functions that end without a return, where the x86 code returns the value the trailing
# statement leaves in eax / ST0 (generated by tests/s1b; each site verified: MSVC 2008 compiles the
# function with `return <statement>` to the same bytes as the pristine decomp). prepare's FALL1 trap
# stays behind the return, unreachable. Method: docs/PATCHES.md.

@@ RET1 src/fallout_shared/tesscriptfunctions.cpp 0x005c4a10
# x86 0x005c4a10 (u1117), last call `call ?FUN_0059f450@@YA_NPAVTESObjectREFR@@PAX1AAN@Z`: MSVC compiles the function with the return to the same
# bytes, so the x86 result is the trailing statement's value.
<<<
FUN_0059f450(reference, reinterpret_cast<void*>(formID), 0, result);
===
return FUN_0059f450(reference, reinterpret_cast<void*>(formID), 0, result);
>>>

@@ RET1 src/fallout_shared/tesscriptfunctions.cpp 0x005c74d0
# x86 0x005c74d0 (u1117), last call `call ?FUN_0059ed30@@YA_NPAVTESObjectREFR@@PAX1PAN@Z`: MSVC compiles the function with the return to the same
# bytes, so the x86 result is the trailing statement's value.
<<<
FUN_0059ed30(apRefObject, reinterpret_cast<void*>(pactor), 0, afReturnValue);
===
return FUN_0059ed30(apRefObject, reinterpret_cast<void*>(pactor), 0, afReturnValue);
>>>


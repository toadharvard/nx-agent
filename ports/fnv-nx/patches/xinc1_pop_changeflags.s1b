# XINC1 pop-mismatch - GetChangeFlags / operator bool: the flag word belongs to the second call (docs/PATCHES.md).
# 0x00428110 returns the form's change mask through MSVC's hidden result buffer and takes nothing else (`ret 4`);
# 0x004280f0 is `bool (unsigned int flags) const { return (mask & flags) != 0; }` (`ret 4`). The decomp declares the
# first with the flag (pops 8 expected) and the second as `operator bool()` (pops 0): both calls take one stack word,
# the pushes (flag, then buffer) are the same.

@@ XINC1 src/bgsencounterzone.cpp 0x00526410
# x86 0x00526410 (/Od): `push 2; lea eax,[tmp]; push eax; mov ecx,buffer; call 0x00428110; mov ecx,eax; call
# 0x004280f0`, twice (2, 0x80000000): GetChangeFlags().IsChanged(flag).
<<<
    operator bool() const;
};
struct BGSSaveFormBuffer
{
    FormChangeMask GetChangeFlags(unsigned int);
===
    operator bool() const; bool FUN_004280f0(unsigned int) const; /* fnv-nx XINC1: 0x004280f0 tests the mask */
};
struct BGSSaveFormBuffer
{
    FormChangeMask GetChangeFlags(); /* fnv-nx XINC1: 0x00428110 takes only its result buffer */
>>>
<<<
    if (apSaveGameBuffer->GetChangeFlags(2))
===
    if (apSaveGameBuffer->GetChangeFlags().FUN_004280f0(2))
>>>
<<<
    if (apSaveGameBuffer->GetChangeFlags(0x80000000))
===
    if (apSaveGameBuffer->GetChangeFlags().FUN_004280f0(0x80000000))
>>>


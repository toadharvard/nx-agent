# DBUG1 - BaseFormComponent virtuals called on a member whose own class overrides them (W36, R2 ranks 13 / 16 / 17).
# Method: docs/PATCHES.md. The exe's BaseFormComponent vftable (0x01011d68) holds only _purecall in slots 0..3 (Init,
# Free, CopyFromBase, CompareWithBase). The original calls these on a member object through the member's own vptr
# (`call [vptr+0|8|0xc]`; 59 sites in 11 units, each counted against a call of the same slot in the caller's exe
# code); the decomp's class copy declares none of them, so GCC's front end resolves `member.CopyFromBase(x)` on a
# complete object to BaseFormComponent::CopyFromBase, which units.json places at an address inside another function.
# Each hunk declares the override that the member's exe vftable holds, so the call reaches `T::f`, which the link
# binds through the exe vftable slot (tier exe-slot) as it does for classes that declare them already (TESTexture in
# testexture_decls.h). MSVC keeps its virtual call: the patched functions compile to the same code. The hunks anchor on
# the first member line of the class (prepare's MSVCBASE rule adds a token after the opening brace).

@@ DBUG1 include/TESTexture.h file
# exe vftable ??_7TESTexture 0x0101d7c4: slot 0 0x0048e340, slot 2 0x0048e4a0, slot 3 0x0048e4f0 (TESIcon 0x01011cd4 and
# TESTexture1024 0x0102beb4 hold the same three). Callers whose exe code calls them through [vptr+0] / +8 / +0xc at
# the member: TESCaravanCard::ResetFormData 0x0059a670 (2 Init), FUN_005fd210 0x005fd210 (CopyFromBase of the rank
# texture), FactionCompareAccess 0x005fd000, WaterEffectSetting 0x0057fde0, InitIcon 0x0047a200 (Icon.Init).
<<<
    BSStringT<char> FullNameComponent;  // +0x4
===
    virtual void Init();                                /* fnv-nx DBUG1: exe vftable slot 0 */
    virtual void CopyFromBase(BaseFormComponent*);      /* fnv-nx DBUG1: exe vftable slot 2 */
    virtual bool CompareWithBase(BaseFormComponent*);   /* fnv-nx DBUG1: exe vftable slot 3 */
    BSStringT<char> FullNameComponent;  // +0x4
>>>

@@ DBUG1 src/TESTexture.h file
# Same class as include/TESTexture.h (exe 0x0101d7c4: slots 0 / 2 / 3 = 0x0048e340 / 0x0048e4a0 / 0x0048e4f0). Caller
# FUN_005063d0 0x005063d0 calls CompareWithBase through [vptr+0xc] on the three effect-shader textures.
<<<
    BSStringT<char> FullNameComponent;  // +0x4
===
    virtual void Init();                                /* fnv-nx DBUG1: exe vftable slot 0 */
    virtual void CopyFromBase(BaseFormComponent*);      /* fnv-nx DBUG1: exe vftable slot 2 */
    virtual bool CompareWithBase(BaseFormComponent*);   /* fnv-nx DBUG1: exe vftable slot 3 */
    BSStringT<char> FullNameComponent;  // +0x4
>>>


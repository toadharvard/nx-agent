# DBUG1 - W35: block-scoped arrays whose address is used after the block closes. Method: docs/PATCHES.md.

@@ DBUG1 src/bssystem/archive.cpp 0x00afd390
# x86 0x00afd390 builds both the extension buffer and the name buffer in its own frame and hands their addresses to
# the name-hash call after the splitpath work; modes 0 and 1 end with no copy. The decomp declares them in nested
# blocks and uses `path = fname` / `pExt = ext` after the blocks close, so GCC ends their lifetime at the brace and
# drops the `.` test and the backslash strip as dead stores. GCC builds hoist both to function scope; MSVC keeps the
# nested declarations so its frame stays as measured.
<<<
    const char* pExt = 0;
    if (mode != 2)
    {
        char ext[16];
===
#ifndef _MSC_VER
    char ext[16];
    char fname[260];
#endif
    const char* pExt = 0;
    if (mode != 2)
    {
#ifdef _MSC_VER
        char ext[16];
#endif
>>>
<<<
                    char fname[260];

                    drive[0]
===
#ifdef _MSC_VER
                    char fname[260];
#endif

                    drive[0]
>>>

# FTOL1 - float -> int casts that MSVC compiled to `call __ftol2_sse` and whose operand can leave int32 (S13
# difffuzz-5, J-0087). The CRT's _ftol2_sse is `cvttsd2si eax` on every SSE2 machine (libcmt ftol2.obj): NaN and
# values outside int32 give 0x80000000, where AArch64 fcvtzs gives 0 (NaN) or 0x7fffffff (too large). The casts go
# through fnvnx_ftol2_sse, the inline exact helper of ftol1_sites.s1b; under MSVC it is the cast itself
# (tests/s1b/msvc/s1b_check_fi.h), so the check proves each operand. Method: docs/PATCHES.md.

@@ FTOL1 src/bsmenu/font.cpp 0x00a1b450
# x86 0x00a1b450 (/Od): three `call __ftol2_sse` stored to [this+0x24], [this+0x28], [this+0x2c] - the advance
# (double), GetHeight00a1b450 (float in ST0) and f28 - f34. S13: a glyph whose height is too large stores 0x7fffffff
# natively, 0x80000000 on an SSE2 PC.
<<<
// Initialises a glyph record from a font index and flag, computing advance, height and offset from the font blob data.
===
static inline int (fnvnx_ftol2_sse)(double x) { int ok = (x > -2147483649.0) & (x < 2147483648.0); int r = (int)(ok ? x : 0.0); return ok ? r : (-2147483647 - 1); } /* fnv-nx FTOL1: _ftol2_sse, cvttsd2si: NaN / outside int32 -> 0x80000000 */
>>>
<<<
    m24 = (int)(((pGlyphRecord->f24 + pGlyphRecord->f24) != 0.0) ? (double)(pGlyphRecord->f2c + pGlyphRecord->f30) : 0.0);
===
    m24 = fnvnx_ftol2_sse(((pGlyphRecord->f24 + pGlyphRecord->f24) != 0.0) ? (double)(pGlyphRecord->f2c + pGlyphRecord->f30) : 0.0);
>>>
<<<
    m28 = (int)GetHeight00a1b450(m0);
===
    m28 = fnvnx_ftol2_sse(GetHeight00a1b450(m0));
>>>
<<<
    m2c = (int)(pGlyphRecord->f28 - pGlyphRecord->f34);
===
    m2c = fnvnx_ftol2_sse(pGlyphRecord->f28 - pGlyphRecord->f34);
>>>

@@ FTOL1 src/fallout_shared/pathfinding/navmesh.cpp 0x006912a0
# x86 0x006912a0 (/Od, NavMeshGrid::GetCellCoords, inlined into GetCellIndex 0x00691260 on the target): `call
# FUN_00406ce0; call __ftol2_sse` for the column and the row, then ClampInt to [0, width - 1]. S13: a point far
# outside the grid; an SSE2 PC clamps 0x80000000 to cell 0, fcvtzs's 0x7fffffff clamps to the last cell.
<<<
void __cdecl ClampInt(int* value, int lo, int hi);
===
void __cdecl ClampInt(int* value, int lo, int hi); static inline int (fnvnx_ftol2_sse)(double x) { int ok = (x > -2147483649.0) & (x < 2147483648.0); int r = (int)(ok ? x : 0.0); return ok ? r : (-2147483647 - 1); } /* fnv-nx FTOL1: _ftol2_sse, cvttsd2si: NaN / outside int32 -> 0x80000000 */
>>>
<<<
    int nCol = (int)FUN_00406ce0(gx1);
===
    int nCol = fnvnx_ftol2_sse(FUN_00406ce0(gx1));
>>>
<<<
    int row = (int)FUN_00406ce0(gY);
===
    int row = fnvnx_ftol2_sse(FUN_00406ce0(gY));
>>>

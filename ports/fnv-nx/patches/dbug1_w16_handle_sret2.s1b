# DBUG1 (stream S2-bodies, worker W16) - the other two users of the callee 0x00dba6a0, whose by-value struct result is
# declared where the definition takes the result pointer explicitly (same fault as dbug1_w12_handle_sret.s1b;
# docs/PATCHES.md "DBUG1").

@@ DBUG1 src/havok/common/serialize/data/util/hkdataobjectutil.cpp 0x00dc5440
# x86 0x00dc5440 (the node-collecting loop): `lea eax,[esp+0x1c]; push eax; lea ecx,[esp+0x18]; call 0x00dba6a0;
# mov ecx,eax; call 0x00dba670` (ecx = the iterator `it`, one stack word = the address of a stack temporary, and the
# returned pointer is the this of the next call), and, on the other arm, the same with a second temporary
# (`lea ecx,[esp+0x18]; push ecx; ...; call 0x00dba6a0; mov ecx,eax; call 0x00dba680`); each temporary is destroyed
# with 0x00dba660 afterwards. The callee 0x00dba6a0 (hkdataobject.cpp, `void* FUN_00dba6a0_cls::SetShiftedValue(void*
# pTarget)`, `ret 4`) calls its owner's virtual slot 4, stores the result into pTarget through 0x00dba650 (the
# one-word constructor) and returns pTarget: an MSVC hidden result pointer, written out as an explicit parameter. MSVC
# lowers `DCIterator f()` and `void* f(void* out)` to the same code, GCC does not (the by-value struct comes back
# through the indirect-result register x8, the definition reads x1), so the native callee wrote through an undefined
# pointer. Fix: declare the member with the explicit out-pointer the definition has and pass a temporary of the same
# type that lives to the end of the full expression (so its destructor 0x00dba660 runs there, as the by-value
# result's did; the arm not taken builds no temporary). MSVC keeps the original text (byte-identical by construction).
# The reference's decoration changes (units_renames.tsv).
<<<
    DCIterator SetShiftedValue()
===
#ifdef _MSC_VER
    DCIterator SetShiftedValue()
#else
    void* SetShiftedValue(void* apOut)
#endif
    /* exception specification follows */
>>>
<<<
            node = it.SetShiftedValue().FUN_00dba670() ? 0 : it.SetShiftedValue().FUN_00dba680();
===
#ifdef _MSC_VER
            node = it.SetShiftedValue().FUN_00dba670() ? 0 : it.SetShiftedValue().FUN_00dba680();
#else
            node = reinterpret_cast<DCIterator*>(it.SetShiftedValue(const_cast<DCIterator*>(&static_cast<const DCIterator&>(DCIterator(0)))))->FUN_00dba670()
                       ? 0
                       : reinterpret_cast<DCIterator*>(it.SetShiftedValue(const_cast<DCIterator*>(&static_cast<const DCIterator&>(DCIterator(0)))))->FUN_00dba680();
#endif
>>>

@@ DBUG1 src/havok/common/serialize/data/dict/hkdataobjectdict_ehsc_noehsc_variant.cpp 0x00dc85a0
# x86 0x00dc85a0: `lea eax,[esp+0x10]; push eax; lea ecx,[esp+0x50]; call 0x00dba6a0; lea ecx,[esp+0x10]; call
# 0x00dba670` (ecx = klassFrom, one stack word = the address of `parent`, which is then asked for its object kind with
# 0x00dba670), the same hidden result pointer as 0x00dc5440 above and 0x00dbf1a0 (see dbug1_w12_handle_sret.s1b for
# the callee 0x00dba6a0, which stores the parent through the constructor 0x00dba650 and returns the pointer). The
# decomp declared `hkDataClassX getParent() const` and copied the result; GCC returns it through x8 where the
# definition reads x1. Fix: declare the explicit out-pointer and call it on `parent`, constructed first (the one-word
# constructor 0x00dba650, which the callee repeats). MSVC keeps the original text (byte-identical by construction).
# The reference's decoration changes (units_renames.tsv).
<<<
    hkDataClassX getParent() const
===
#ifdef _MSC_VER
    hkDataClassX getParent() const
#else
    void* getParent(void* apOut) const
#endif
    /* exception specification follows */
>>>
<<<
    hkDataClassX parent = klassFrom.getParent();
===
#ifdef _MSC_VER
    hkDataClassX parent = klassFrom.getParent();
#else
    hkDataClassX parent(0);
    klassFrom.getParent(&parent);
#endif
>>>

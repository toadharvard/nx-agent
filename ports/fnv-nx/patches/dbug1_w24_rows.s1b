# DBUG1 (stream S2-bodies, worker W24): declarations that disagree with the x86 code, from EQ fuzz rows 0x008faa50,
# 0x009308f0 and 0x00dd7d00 (docs/PATCHES.md "DBUG1").

@@ DBUG1 src/fallout/ai/highprocess.cpp 0x008faa50
# x86 0x008faa50 (SaveToStream) calls 0x00408d60 twice (0x008faa89, 0x008fb233). 0x00408d60 returns a pointer (this+4,
# or the address of a zero byte when this is null; eax = pointer), and both callers test the byte it points to:
# `movzx eax, byte [eax]; test eax, eax; je` - any nonzero byte counts. The decomp declared the result `const bool&`,
# which GCC reads with `ldrb; tbnz #0`: only bit 0 of the byte, so an even nonzero byte (0x02, 0x80) takes the false
# branch natively. Read the byte as unsigned char at both sites (`movzx; test` in MSVC, as in x86); the declaration,
# and so every decorated name, stays.
<<<
    if (DAT_011de4e8.FUN_00408d60())
        start = DAT_011de45c->FUN_00825c00();
===
    if (*(const unsigned char*)&DAT_011de4e8.FUN_00408d60())
        start = DAT_011de45c->FUN_00825c00();
>>>
<<<
    if (DAT_011de4e8.FUN_00408d60())
    {
        unsigned char* end = DAT_011de45c->FUN_00825c00();
===
    if (*(const unsigned char*)&DAT_011de4e8.FUN_00408d60())
    {
        unsigned char* end = DAT_011de45c->FUN_00825c00();
>>>

@@ DBUG1 src/fallout/ai/actor.cpp 0x009306d0
# x86 0x009306d0 (thiscall): `if (this->f68) return this->f68->vtbl[0x28c / 4]()`, else 0. The decomp has exactly that
# body, but declares the object at +0x68 as `DummyProcess`, a class in an anonymous namespace whose virtual functions
# nothing defines and nothing derives from or constructs. GCC (ipa-devirt) knows no object of such a type exists, so the
# virtual call is unreachable, the non-null branch is dropped and the native body folds to `mov x0, 0; ret`. The class
# leaves the anonymous namespace (it names no symbol: no vtable, no RTTI and no decorated name carries it), so GCC
# calls through the object's vptr as the x86 code does; MSVC compiles the same code.
<<<
namespace {
struct DummyProcess
{
===
struct DummyProcess
{
>>>
<<<
    virtual bhkCharacterController* GetPhysicsCharacterController();
};
}
===
    virtual bhkCharacterController* GetPhysicsCharacterController();
};
>>>

@@ DBUG1 src/havok/physics/dynamics/world/simulation/continuous/hkpcontinuoussimulation.cpp file
# x86 0x00dd7d00 (the sort; 0x00dd7d30 etc.): each comparison is `lea ecx,[esp+N]; push ecx; push b; push a; call
# [ebp+0x14]; cmp byte [eax], 0` - every comparator is called with a hidden result pointer as its first argument and
# returns that pointer. The sort is compiled with the comparator typed as returning a one-byte class
# (hkpworldoperationutil.cpp S_00dd7d00_Less), which GCC returns in w0 and calls as comparator(a, b); the comparators the
# callers pass declare the result pointer as an explicit first parameter (IsLessByUnkD4 0x00d0bc60: bool*(bool*, a, b)),
# so natively they read (a, b) as (result, a) and write through a, and the sort tests a stale w0. The sort is passed an
# adapter with the class convention that calls the real comparator with a local result (the comparators passed as class
# returns, 0x00cb3f90 and CompareItemPriority, already agree with the sort). MSVC keeps the original function.
<<<
    *pbResult = uiValueA < uiValueB;
    return pbResult;
}
===
    *pbResult = uiValueA < uiValueB;
    return pbResult;
}
#ifdef _MSC_VER
#define IsLessByUnkD4_cmp IsLessByUnkD4
#else
static bool IsLessByUnkD4_native(SpawnedObject *pObjectA, SpawnedObject *pObjectB)
{
    bool bResult;
    IsLessByUnkD4(&bResult, pObjectA, pObjectB);
    return bResult;
}
#define IsLessByUnkD4_cmp IsLessByUnkD4_native
#endif
>>>
<<<
(void*)IsLessByUnkD4);
===
(void*)IsLessByUnkD4_cmp);
>>>

@@ DBUG1 src/havok/physics/dynamics/world/simulation/multithreaded/hkpmultithreadedsimulation.cpp file
# x86 0x00dd7d00 / 0x00d02220: see hkpcontinuoussimulation.cpp in this patch. CompareObjectKeys is a comparator with an
# explicit result pointer (the x86 code returns the pointer in eax; the decomp returns nothing); natively the sort gets
# an adapter with the class convention.
<<<
    *result = left->reference->value->key < right->reference->value->key;
}
===
    *result = left->reference->value->key < right->reference->value->key;
}
#ifdef _MSC_VER
#define CompareObjectKeys_cmp CompareObjectKeys
#else
static bool CompareObjectKeys_native(CompareObject* left, CompareObject* right)
{
    bool bResult;
    CompareObjectKeys(&bResult, left, right);
    return bResult;
}
#define CompareObjectKeys_cmp ((void(__cdecl*)(bool*, CompareObject*, CompareObject*))CompareObjectKeys_native)
#endif
>>>
<<<
0, size - 1, CompareObjectKeys);
===
0, size - 1, CompareObjectKeys_cmp);
>>>

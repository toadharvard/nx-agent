# XINC1 - W37: 0x00cb0c00 calls the placed 0x00cb0b10 with its arguments in the placed definition's order, not through
# a placeholder (int, int, int) overload that takes them permuted. Method: docs/PATCHES.md.
# (0x00cb0bd0, the string pointer's copy constructor, is left: its CB0SelfRef overload is an extern declaration bound to
# 0x00cb0b10 in the prepared tree (STAND4), called with (slot = this, string = other's untagged pointer, -1): the placed
# definition's order. No defect on the GCC side.)

@@ XINC1 src/staging/blk_00ca0000_o2.cpp 0x00cb0c00
# x86 0x00cb0c00 (fastcall, plain ret): pushes ecx (the argument) as the callee's stack word, ecx = 0 (xor ecx, ecx),
# eax = -1, calls 0x00cb0b10, pops the word. So the call is the placed definition with (slot = the argument, string =
# null, length -1): it frees the slot's old tagged string and stores the global at 0x01268358 (the null-string path).
# Not a (0, -1, p) call of a helper that only stores their sum.
<<<
    int x = FUN_00cb0b10(0, -1, p);
    (void)x;
===
    StringSlot slot = {(unsigned int*)p};
    FUN_00cb0b10(slot, (char*)0, -1);
>>>

# DBUG1 - destructors the decomp declares at slot 0 where the exe's vftable has none there (W36, item 2 of the
# S2-bodies hand-off; vtmetric rows `slot-mismatch` of link 3f7a6c35). Method: docs/PATCHES.md.
# A `virtual ~X()` in the unit that hosts a class's native vtable gives Itanium D1/D0 at slots 0/1, and the link
# numbers the exe's slots minus-one behind that pair (exe slot k at native k + 1). That is right only where the
# exe's slot 0 is the deleting destructor. In the classes below the exe's vftable holds something else at slot 0 and
# either no destructor at all (the form components: four slots Init, Free, CopyFromBase, CompareWithBase, as
# BaseFormComponent) or the deleting destructor at a later slot (tests: ret 4, test byte [esp+8], 1, call delete).
# Each hunk declares the exe's order.

@@ DBUG1 src/fallout_shared/tesproduceform.cpp file
# exe vftable ??_7TESProduceForm 0x0101d2a4 has four slots: 0x0048b590 (Init: stores 0 at this+4 ...), 0x00483710 (an
# empty method), 0x0048b610 (CopyFromBase: this unit's FUN_0048b610(BaseFormComponent*)), 0x0048b6a0 (CompareWithBase).
# No destructor: it is a BaseFormComponent, whose own vftable 0x01011d68 has these four slots. The unit's local
# BaseFormComponent declared `virtual ~BaseFormComponent()` only to make the dynamic_casts of this file legal.
<<<
    virtual ~BaseFormComponent();
===
    virtual void Init();                                /* fnv-nx DBUG1: exe vftable slot 0 */
    virtual void Free();                                /* fnv-nx DBUG1: exe vftable slot 1 */
    virtual void CopyFromBase(BaseFormComponent*);      /* fnv-nx DBUG1: exe vftable slot 2 */
    virtual bool CompareWithBase(BaseFormComponent*);   /* fnv-nx DBUG1: exe vftable slot 3 */
>>>

@@ DBUG1 src/fallout_shared/tesdatahandler_forms.h file
# The form components that tesdatahandler.cpp's BGSMovableStatic / TESFlora derive from. exe vftables, four slots each and
# no deleting destructor at slot 0: TESFullName 0x01011d54 (0x0048ce80, 0x00483710, 0x004870f0, 0x00487140; the primary
# vftable of BGSMovableStatic 0x01024e84 is this one: the object starts with TESFullName), BGSDestructibleObjectForm
# 0x01024e70 (0x008c6060, 0x00478690, 0x004786e0, 0x00478900), TESProduceForm 0x0101d2a4 (0x0048b590, 0x00483710,
# 0x0048b610, 0x0048b6a0). The destructor stays declared, not virtual (the exe has no virtual one in these classes).
<<<
    virtual ~TESFullName();
===
    virtual void Init();                                /* fnv-nx DBUG1: exe vftable slot 0 */
    virtual void Free();                                /* fnv-nx DBUG1: exe vftable slot 1 */
    virtual void CopyFromBase(void*);                   /* fnv-nx DBUG1: exe vftable slot 2 */
    virtual bool CompareWithBase(void*);                /* fnv-nx DBUG1: exe vftable slot 3 */
    ~TESFullName();
>>>
<<<
    virtual ~BGSDestructibleObjectForm();
===
    virtual void Init();                                /* fnv-nx DBUG1: exe vftable slot 0 */
    virtual void Free();                                /* fnv-nx DBUG1: exe vftable slot 1 */
    virtual void CopyFromBase(void*);                   /* fnv-nx DBUG1: exe vftable slot 2 */
    virtual bool CompareWithBase(void*);                /* fnv-nx DBUG1: exe vftable slot 3 */
    ~BGSDestructibleObjectForm();
>>>
<<<
    virtual ~TESProduceForm();
===
    virtual void Init();                                /* fnv-nx DBUG1: exe vftable slot 0 */
    virtual void Free();                                /* fnv-nx DBUG1: exe vftable slot 1 */
    virtual void CopyFromBase(void*);                   /* fnv-nx DBUG1: exe vftable slot 2 */
    virtual bool CompareWithBase(void*);                /* fnv-nx DBUG1: exe vftable slot 3 */
    ~TESProduceForm();
>>>

@@ DBUG1 src/gamebryo2.2/corelibs/niconsolerenderer/niunsharedgeometrygroup.cpp file
# exe vftable ??_7NiUnsharedGeometryGroup 0x010f1008 has ten slots; slot 0 is 0x00a29680 (`ret`), slots 1..7 other
# methods, slot 8 0x00ee8990 (`xor al, al; ret`) and slot 9 0x00e94d30, the deleting destructor this unit defines as
# Destroy(flags): restores the vftable word, clears the global, `test byte [esp+8], 1` then delete, `ret 4`. The destructor
# is slot 9, behind nine plain virtuals.
<<<
    virtual ~NiUnsharedGeometryGroup();
===
    virtual void v0(); virtual void v1(); virtual void v2(); virtual void v3(); virtual void v4();   /* fnv-nx DBUG1: exe */
    virtual void v5(); virtual void v6(); virtual void v7(); virtual void v8();                       /* slots 0..8 */
    virtual ~NiUnsharedGeometryGroup();                 /* fnv-nx DBUG1: exe vftable slot 9 (0x00e94d30) */
>>>

@@ DBUG1 src/gamebryo2.2/corelibs/nicollision/nihalfspacebv.cpp file

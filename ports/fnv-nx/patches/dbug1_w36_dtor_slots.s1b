# bounding-volume methods (NiBoxBV 0x010f1814 and NiSphereBV 0x010f1854 repeat 0x00eac1d0 at slot 2). The destructor is
# slot 2, behind two plain virtuals; NiHalfSpaceBV inherits the order.
<<<
    virtual ~NiBoundingVolume();
===
    virtual void v0();                                  /* fnv-nx DBUG1: exe vftable slot 0 */
    virtual void v1();                                  /* fnv-nx DBUG1: exe vftable slot 1 */
    virtual ~NiBoundingVolume();                        /* fnv-nx DBUG1: exe vftable slot 2 (0x00eac1d0) */
>>>

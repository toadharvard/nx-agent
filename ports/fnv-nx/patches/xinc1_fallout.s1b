@@ XINC1 src/fallout/interface/menus/computersmenu.cpp 0x007577f0
# x86 0x007577f0+0xb5 (/Od): `mov [edx+0xec],0x00759030`, `+0xf0 <- 0x007590c0`, `+0xf4 <- 0x00759470` - three code
# addresses stored as 4-byte table entries. The table is m_handlers of HostF (0x00757f70+0x37c: `push note; mov
# ecx,this; mov eax,[edx+eax*4+0xec]; call eax`): MSVC pointers to member functions (`void (HostF::*)(Note*)`,
# 4 bytes for a single-inheritance class) of thiscall functions taking one note: 0x00759030
# Shell_759030::PlayNoteSound(BGSNote*), 0x007590c0 TextMenu::SetTextSource(TextSource*), 0x00759470
# FUN_00759470_Class::UpdateNoteDisplay(BGSNote*). The decomp's `void (*)()` stores only worked for the bytes. A GCC
# pointer to member is 8 bytes (would move every later field), so on the target the entries are plain function
# pointers taking this explicitly, filled with the member functions' code addresses (G++'s PMF -> function pointer
# conversion); the MSVC branch keeps the decomp's spelling (MSVC has no such conversion).
<<<
void PlayNoteSound();
void SetTextSource();
void UpdateNoteDisplay();
===
#ifdef _MSC_VER
void PlayNoteSound();
void SetTextSource();
void UpdateNoteDisplay();
#else /* fnv-nx XINC1: the handlers are thiscall members taking a note (0x00759030, 0x007590c0, 0x00759470) */
struct FUN_007577f0_s1b { void FUN_00759030(BGSNote*); void FUN_007590c0(TextSource*); void FUN_00759470(BGSNote*); };
#endif
>>>
<<<
    callbackec = PlayNoteSound;
    callbackf0 = SetTextSource;
    callbackf4 = UpdateNoteDisplay;
===
#ifdef _MSC_VER
    callbackec = PlayNoteSound;
    callbackf0 = SetTextSource;
    callbackf4 = UpdateNoteDisplay;
#else /* fnv-nx XINC1: code addresses of the member functions */
    callbackec = (void (*)())(void (*)(FUN_007577f0_s1b*, BGSNote*))(&FUN_007577f0_s1b::FUN_00759030);
    callbackf0 = (void (*)())(void (*)(FUN_007577f0_s1b*, TextSource*))(&FUN_007577f0_s1b::FUN_007590c0);
    callbackf4 = (void (*)())(void (*)(FUN_007577f0_s1b*, BGSNote*))(&FUN_007577f0_s1b::FUN_00759470);
#endif
>>>


@@ XINC1 src/fallout/ai/combat/flameprojectile_o2_variant_od_oy_noo2_variant.cpp 0x009b36f0
# x86 0x009b36f0+0x1e0 (/Od): `lea edx,[ebp-0x164]; push edx; mov ecx,this; call 0x00874480; mov ecx,eax; call
# 0x00931ed0; mov ecx,eax; call 0x004a3a20; push eax; call 0x0059ce80`. The definitions say what that is:
# 0x00931ed0 returns GlobalObject_008c71b0 BY VALUE (member: hidden result pointer = the pushed [ebp-0x164], eax =
# that buffer), 0x004a3a20 is `unsigned FUN_004a3a20_shell::FUN_004a3a20()` called on the returned temporary, and
# 0x0059ce80 takes `unsigned int` by value (as 0x005dbe10 returns `unsigned int`, used the same way below). The
# decomp moved the hidden pointer to 0x004a3a20 (FilterKey by value) and passed it on by reference: the same x86
# bytes, but on AArch64 the result buffer goes in x8, not on the stack. Declarations follow the definitions; the
# 4-byte handle class is BoundForm here.
<<<
    void FUN_0059ce80(const FilterKey& kKey);
===
    void FUN_0059ce80(unsigned int uiKey); /* fnv-nx XINC1: 0x0059ce80 takes the key by value */
>>>
<<<
    BoundForm* FUN_00931ed0();
===
    BoundForm FUN_00931ed0(); /* fnv-nx XINC1: 0x00931ed0 returns the handle by value */
>>>
<<<
struct BoundForm
{
    FilterKey FUN_004a3a20();
};
===
struct BoundForm
{
    unsigned int m_uiHandle; unsigned int FUN_004a3a20(); /* fnv-nx XINC1: 4-byte handle, 0x004a3a20 returns unsigned */
};
>>>
<<<
extern const FilterKey& FUN_005dbe10();
===
extern unsigned int FUN_005dbe10(); /* fnv-nx XINC1: 0x005dbe10 returns unsigned int */
>>>
<<<
            objectHandle.FUN_0059ce80(FUN_00874480()->FUN_00931ed0()->FUN_004a3a20());
===
            objectHandle.FUN_0059ce80(FUN_00874480()->FUN_00931ed0().FUN_004a3a20());
>>>


# eax is 0x00950110's result, and 0x00950110 is `bool FUN_00950110_pc::FUN_00950110(bool)` (defined in this file).
<<<
    void FUN_00950110(bool);
    bool FUN_00950340(bool abForceCameraDistance);
===
    bool FUN_00950110(bool); /* fnv-nx RET1: 0x00950110 returns bool */
    bool FUN_00950340(bool abForceCameraDistance);
>>>
<<<
    FUN_00950110(false);
===
    return FUN_00950110(false);
>>>


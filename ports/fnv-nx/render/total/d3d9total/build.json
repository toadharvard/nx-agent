{
 "format": "fnvnx-recipe/1",
 "run": [
  {
   "name": "gate",
   "exec": "/usr/bin/python3",
   "args": [
    "-I",
    "-B",
    "/in/1",
    "--out",
    "/out/d3d9total.json",
    "--gcc",
    "/usr/bin/gcc",
    "--clang",
    "/usr/bin/clang",
    "--wine",
    "/in/2",
    "--mojoshader",
    "/in/3",
    "--sm-table",
    "/in/4",
    "--sm-rows",
    "/in/5",
    "--work",
    "/scratch/work",
    "--tree",
    "6=render/d3d9/front",
    "--tree",
    "7=render/d3d9/env",
    "--tree",
    "8=render/d3d9/build.json",
    "--tree",
    "9=render/d3d9/gen",
    "--tree",
    "10=bridgefacts/d3d9",
    "--tree",
    "11=render/shaders/translator/build.json",
    "--include-of",
    "/in/12",
    "--include-of",
    "/in/13"
   ],
   "inputs": [
    "ports/fnv-nx/render/total/d3d9total/stage.py",
    {
     "external_of": "ports/fnv-nx/render/d3d9",
     "name": "wine-d3d9-formats",
     "path": "."
    },
    {
     "external_of": "ports/fnv-nx/render/shaders/translator",
     "name": "mojoshader",
     "path": "."
    },
    {
     "stage": "ports/fnv-nx/render/shaders/total:gen:0",
     "path": "gen/sm_table.json"
    },
    {
     "stage": "ports/fnv-nx/render/shaders/total:gen:0",
     "path": "gen/inc/fnvnx_sm_rows.h"
    },
    "ports/fnv-nx/render/d3d9/front",
    "ports/fnv-nx/render/d3d9/env",
    "ports/fnv-nx/render/d3d9/build.json",
    "ports/fnv-nx/render/d3d9/gen",
    "ports/fnv-nx/bridgefacts/d3d9",
    "ports/fnv-nx/render/shaders/translator/build.json",
    {
     "include_of": "ports/fnv-nx/render/d3d9"
    },
    {
     "include_of": "ports/fnv-nx/render/shaders/translator"
    }
   ],
   "debs": {
    "closure": [
     "python3",
     "gcc",
     "gcc-13",
     "clang",
     "clang-18",
     "libc6-dev",
     "libc6-dev-i386",
     "libgcc-13-dev",
     "libclang-common-18-dev"
    ]
   },
   "scratch": [
    "/scratch"
   ],
   "outputs": [
    "d3d9total.json"
   ]
  }
 ],
 "outputs": {
  "D3D9TOTAL": "d3d9total.json"
 }
}

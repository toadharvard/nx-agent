+// fnv-nx: library use. The uam CLI compiles one shader per process and leaves these to process exit; a library caller compiles many.
+// Frees the parameter list the state tracker attaches to each linked program (get_mesa_program_tgsi), the linked programs and shaders
+// themselves and the uniform name map the linker creates (link_assign_uniform_locations); all are owned by the gl_shader_program being compiled.
+// Call only after the outputs were taken (the _LinkedShaders are gone afterwards). Idempotent.
+void glsl_program_release_library_state(glsl_program prg)
+{
+	for (unsigned i = 0; i < MESA_SHADER_STAGES; i++) {
+		struct gl_linked_shader* ls = prg->_LinkedShaders[i];
+		if (!ls) continue;
+		if (ls->Program) {
+			if (ls->Program->Parameters) _mesa_free_parameter_list(ls->Program->Parameters);
+			ralloc_free(ls->Program);   // glsl_program_free frees the program only; the linked shader (and what the linker hung on it) is a ralloc tree of its own
+			ls->Program = NULL;
+		}
+		ralloc_free(ls);
+		prg->_LinkedShaders[i] = NULL;
+	}
+	delete prg->UniformHash;
+	prg->UniformHash = NULL;
+}

diff --git a/source/uam_api.cpp b/source/uam_api.cpp
new file mode 100644
index 0000000..69fc7cd
--- /dev/null
+++ b/source/uam_api.cpp
@@ -0,0 +1,21 @@
+#include "compiler_iface.h"
+#include "uam_api.h"
+extern "C" int uam_compile_dksh(int stage, const char* glsl, uam_result* out)
+{
+	memset(out, 0, sizeof(*out));
+	DekoCompiler c{(pipeline_stage)stage};
+	if (!c.CompileGlsl(glsl))
+		return 0;
+	std::vector<uint8_t> v;
+	c.OutputDkshToMemory(v);
+	out->dksh = (uint8_t*)malloc(v.size());
+	if (!out->dksh) return 0;
+	memcpy(out->dksh, v.data(), v.size());
+	out->dksh_size = v.size();
+	out->num_gprs = c.GetNumGprs();
+	out->num_instructions = c.GetNumInstructions();
+	out->code_size = c.GetCodeSize();
+	out->constbuf1_size = c.GetConstbuf1Size();
+	return 1;
+}
+extern "C" void uam_free(uam_result* r) { free(r->dksh); r->dksh = NULL; }
diff --git a/source/uam_api.h b/source/uam_api.h
new file mode 100644
index 0000000..a4e5a98
--- /dev/null
+++ b/source/uam_api.h
@@ -0,0 +1,21 @@
+// fnv-nx: minimal C API over DekoCompiler (library build of uam)
+#pragma once
+#include <stddef.h>
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+typedef struct uam_result {
+	uint8_t* dksh;       /* malloc'd, free with uam_free */
+	size_t dksh_size;
+	uint32_t num_gprs;
+	uint32_t num_instructions;
+	uint32_t code_size;
+	uint32_t constbuf1_size;
+} uam_result;
+/* stage: 0 vert, 1 tess_ctrl, 2 tess_eval, 3 geom, 4 frag, 5 comp (pipeline_stage order) */
+int uam_compile_dksh(int stage, const char* glsl, uam_result* out);
+void uam_free(uam_result* r);
+#ifdef __cplusplus
+}
+#endif

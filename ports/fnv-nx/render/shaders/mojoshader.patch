+#if SUPPORT_PROFILE_GLSLDK
+// fnv-nx deko3d profile: fixed locations so separately compiled stages and
+//  the D3D9 front end (vertex declarations) agree without linking.
+//  Keep in sync with render/shaders/include/fnvnx_dk_layout.h.
+static int dk_attrib_location(Context *ctx, MOJOSHADER_usage usage, int index)
+{
+    // uam (like GL) has 16 vertex attributes: 0..15.
+    switch (usage)
+    {
+        case MOJOSHADER_USAGE_POSITION:     if (index == 0) return 0; break;
+        case MOJOSHADER_USAGE_BLENDWEIGHT:  if (index == 0) return 1; break;
+        case MOJOSHADER_USAGE_BLENDINDICES: if (index == 0) return 2; break;
+        case MOJOSHADER_USAGE_NORMAL:       if (index == 0) return 3; break;
+        case MOJOSHADER_USAGE_COLOR:        if (index < 2) return 4 + index; break;
+        case MOJOSHADER_USAGE_TEXCOORD:     if (index < 8) return 6 + index; break;
+        case MOJOSHADER_USAGE_TANGENT:      if (index == 0) return 14; break;
+        case MOJOSHADER_USAGE_BINORMAL:     if (index == 0) return 15; break;
+        default: break;
+    } // switch
+    failf(ctx, "glsldk: no attribute location for usage %d index %d", (int) usage, index);
+    return 15;
+} // dk_attrib_location
+
+static int dk_varying_location(Context *ctx, MOJOSHADER_usage usage, int index)
+{
+    switch (usage)
+    {
+        case MOJOSHADER_USAGE_COLOR:        if (index < 2) return index; break;
+        case MOJOSHADER_USAGE_TEXCOORD:     if (index < 16) return 2 + index; break;
+        case MOJOSHADER_USAGE_FOG:          if (index == 0) return 18; break;
+        case MOJOSHADER_USAGE_NORMAL:       if (index < 2) return 19 + index; break;
+        case MOJOSHADER_USAGE_TANGENT:      if (index == 0) return 21; break;
+        case MOJOSHADER_USAGE_BINORMAL:     if (index == 0) return 22; break;
+        case MOJOSHADER_USAGE_BLENDWEIGHT:  if (index == 0) return 23; break;
+        case MOJOSHADER_USAGE_BLENDINDICES: if (index == 0) return 24; break;
+        case MOJOSHADER_USAGE_POSITION:     if (index >= 1 && index < 4) return 24 + index; break;
+        case MOJOSHADER_USAGE_DEPTH:        if (index == 0) return 28; break;
+        case MOJOSHADER_USAGE_POINTSIZE:    if (index >= 1 && index < 3) return 28 + index; break;
+        default: break;
+    } // switch
+    failf(ctx, "glsldk: no varying location for usage %d index %d", (int) usage, index);
+    return 31;
+} // dk_varying_location
+
+static void dk_layout(Context *ctx, char *buf, size_t len, int is_attrib,
+                      MOJOSHADER_usage usage, int index)
+{
+    if (!support_glsldk(ctx)) { buf[0] = '\0'; return; }
+    const int loc = is_attrib ? dk_attrib_location(ctx, usage, index)
+                              : dk_varying_location(ctx, usage, index);
+    snprintf(buf, len, "layout(location = %d) ", loc);
+} // dk_layout
+#endif

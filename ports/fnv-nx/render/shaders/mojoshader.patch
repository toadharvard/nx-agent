+void emit_GLSL_BEM(Context *ctx)
+{
+#if SUPPORT_PROFILE_GLSLDK
+    if (dk_ps1x(ctx) || (support_glsldk(ctx) && shader_is_pixel(ctx)))
+    {
+        // MS bem page (ps_1_4): dst.r = src0.r + D3DTSS_BUMPENVMAT00 * src1.r + MAT10 * src1.g ;
+        //  dst.g = src0.g + MAT01 * src1.r + MAT11 * src1.g, with the matrix of the stage whose number is the destination
+        //  register's. texbem[2n] = (00, 01, 10, 11) (driver block). Only r and g are written (write mask .rg).
+        char s0[64], s1[64], m[64], r[96], g[96];
+        get_GLSL_srcarg_varname(ctx, 0, s0, sizeof (s0));
+        get_GLSL_srcarg_varname(ctx, 1, s1, sizeof (s1));
+        snprintf(m, sizeof (m), "ps_drv_texbem[%d]", ctx->dest_arg.regnum * 2);
+        snprintf(r, sizeof (r), "%s.x + %s.x * %s.x + %s.z * %s.y", s0, m, s1, m, s1);
+        snprintf(g, sizeof (g), "%s.y + %s.y * %s.x + %s.w * %s.y", s0, m, s1, m, s1);
+        const char *c[4] = { r, g, "0.0", "0.0" };
+        dk_emit_assign_vec(ctx, c);
+        return;
+    } // if
+#endif
+    fail(ctx, "BEM unimplemented in this profile");

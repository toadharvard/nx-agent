+// fnv-nx: sgn has two forms (the sgn table row is a CONFLICT between the MS sgn page, 3 sources in every version, and vkd3d d3dbc.c,
+//  1 source in vs_3_0): src0 only, or src0 + two scratch temporaries whose contents after the instruction are undefined (we never write them).
+//  The form is read from the instruction token's length field (sm2+ encodes the token count): after the destination (+ its relative
+//  token) and the predicate token (moved last by parse_instruction_token), the remaining tokens are sources; a source token with the
+//  relative bit (13) is followed by one more token. One source -> DS, otherwise DSSS (the MS form).
+static int parse_args_SGN(Context *ctx)
+{
+#if SUPPORT_PROFILE_GLSLDK
+    if (fnvnx_relaxed(ctx) && shader_version_atleast(ctx, 2, 0) && (ctx->tokencount >= 2))
+    {
+        const uint32 dtok = SWAP32(ctx->tokens[0]);
+        uint32 pos = 1 + (((dtok & (1u << 13)) && shader_version_atleast(ctx, 3, 0)) ? 1 : 0);
+        const uint32 end = ctx->fnvnx_insttoks - (ctx->predicated ? 1 : 0);
+        uint32 nsrc = 0;
+        while ((pos < end) && (pos < ctx->tokencount))
+        {
+            const uint32 stok = SWAP32(ctx->tokens[pos]);
+            pos += 1 + (((stok & (1u << 13)) != 0) ? 1 : 0);
+            nsrc++;
+        } // while
+        if (nsrc == 1)
+            return parse_args_DS(ctx);
+    } // if
+    if (support_glsldk(ctx) || fnvnx_relaxed(ctx))
+    {
+        // The MS form: src1 and src2 are scratch temporaries the instruction writes (contents undefined afterwards), not reads: they
+        //  need no earlier write.
+        int retval = 1;
+        int i;
+        retval += parse_destination_token(ctx, &ctx->dest_arg);
+        for (i = 0; i < 3; i++)
+        {
+            if ((i > 0) && (ctx->tokencount > 0))
+            {
+                const uint32 t = SWAP32(ctx->tokens[0]);
+                const RegisterType rt = (RegisterType) (((t >> 28) & 0x7) | ((t >> 8) & 0x18));
+                if ((rt == REG_TYPE_TEMP) && (((t >> 13) & 1) == 0))
+                {
+                    RegisterList *r = set_used_register(ctx, REG_TYPE_TEMP, (int) (t & 0x7ff), 0);
+                    if (r != NULL)
+                        r->written = 1;
+                } // if
+            } // if
+            retval += parse_source_token(ctx, &ctx->source_args[i]);
+        } // for
+        return retval;
+    } // if
+#endif
+    return parse_args_DSSS(ctx);
+} // parse_args_SGN

@@ -0,0 +1,75 @@
+/* fnv-nx: static totality proof of the SM1-3 translation (render/total/gate_d3d9total.py reads it).
+ *
+ * fnvnx_sm_rows.h (generated from render/shaders/total/sm_table.json by render/shaders/total/gen_sm_rows.py, copied next to this file by
+ * render/shaders/build.sh) lists every (stage, opcode value) command of the D3D9 SM1-3 contract.  Each row is checked here against the
+ * instruction table instructions[] of mojoshader.c, which is built from the INSTRUCTION / INSTRUCTION_STATE X-macro list of
+ * mojoshader_internal.h and carries, for every row, emit_<PROFILE>_<op> of every compiled profile (a missing emitter is a link error):
+ *   - the row's NAME is an enumerator built from that list (an unknown NAME is an undeclared identifier);
+ *   - the position of the NAME's entry in the list equals the opcode value (instructions[] is indexed by the opcode token), so a removed,
+ *     moved or RESERVED entry (a RESERVED entry has an empty emitter and fails only at run time) is a failed _Static_assert;
+ *   - the entry's shader-type mask contains the row's stage;
+ *   - comparison forms: the control value of the form equals the one the comparison tables of the glsl profile are indexed by;
+ *   - token-level commands (phase) take their token value from the row, the parser compares with it.
+ * Nothing here emits code: the generated GLSL is unchanged. */
+#ifndef FNVNX_SM_CHECK_H
+#define FNVNX_SM_CHECK_H
+
+/* comparison controls (D3DSHADER_COMPARISON): one table for the translator's operator strings and for the form rows. */
+#define FNVNX_CMP_TABLE(X) \
+    X(gt, 1, ">",  "greaterThan") \
+    X(eq, 2, "==", "equal") \
+    X(ge, 3, ">=", "greaterThanEqual") \
+    X(lt, 4, "<",  "lessThan") \
+    X(ne, 5, "!=", "notEqual") \
+    X(le, 6, "<=", "lessThanEqual")
+
+#ifdef FNVNX_SM_CHECK_PROOF
+#define FNVNX_CAT_(a, b) a##b
+#define FNVNX_CAT(a, b) FNVNX_CAT_(a, b)
+/* RESERVED repeats in the list: every occurrence gets its own enumerator name; a row can never name one (its names are not declared before). */
+#define FNVNX_OPIDX_RESERVED FNVNX_CAT(FNVNX_RSVIDX_, __COUNTER__)
+#define FNVNX_OPTYPE_RESERVED FNVNX_CAT(FNVNX_RSVTYPE_, __COUNTER__)
+
+enum
+{
+    FNVNX_OPIDX_ORIGIN,   /* the entry at position p of the list is FNVNX_OPIDX_ORIGIN + 1 + p (enumerators count up from here) */
+    #define INSTRUCTION_STATE(op, opstr, slots, a, t, w) FNVNX_OPIDX_##op,
+    #define INSTRUCTION(op, opstr, slots, a, t, w) FNVNX_OPIDX_##op,
+    #define MOJOSHADER_DO_INSTRUCTION_TABLE 1
+    #include "mojoshader_internal.h"
+    FNVNX_OPIDX_END_
+};
+
+enum
+{
+    #define INSTRUCTION_STATE(op, opstr, slots, a, t, w) FNVNX_OPTYPE_##op = (t),
+    #define INSTRUCTION(op, opstr, slots, a, t, w) FNVNX_OPTYPE_##op = (t),
+    #define MOJOSHADER_DO_INSTRUCTION_TABLE 1
+    #include "mojoshader_internal.h"
+    FNVNX_OPTYPE_END_
+};
+
+enum
+{
+    #define FNVNX_CMP_ENUM_(name, ctl, scalar, vector) FNVNX_CMPCTL_##name = (ctl),
+    FNVNX_CMP_TABLE(FNVNX_CMP_ENUM_)
+    #undef FNVNX_CMP_ENUM_
+    FNVNX_CMPCTL_END_
+};
+
+#define FNVNX_SM_OP(id, stage, value, NAME) \
+    _Static_assert(FNVNX_OPIDX_##NAME - FNVNX_OPIDX_ORIGIN - 1 == (value), id ": the instructions[] entry of NAME is not at the opcode value"); \
+    _Static_assert((FNVNX_OPTYPE_##NAME & (stage)) == (stage), id ": the stage is not in the shader-type mask of the instructions[] entry");
+
+#define FNVNX_SM_CMP(id, NAME, cmp, ctl) \
+    _Static_assert(FNVNX_CMPCTL_##cmp == (ctl), id ": comparison control differs from the comparison table of the translator");
+
+/* a token-level command (not an instructions[] entry): the parser takes the token value from its row, so the row is load-bearing. */
+#define FNVNX_SM_TOKEN(id, stage, NAME, value) enum { FNVNX_SM_TOKEN_##NAME = (value) };
+
+#include "fnvnx_sm_rows.h"
+
+#undef FNVNX_SM_OP
+#undef FNVNX_SM_CMP
+#endif  /* FNVNX_SM_CHECK_PROOF */
+#endif  /* FNVNX_SM_CHECK_H */

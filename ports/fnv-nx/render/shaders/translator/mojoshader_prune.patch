-            break;
-        case REG_TYPE_PREDICATE:
-            output_line(ctx, "bool4 %s;", varname);
-            break;
-        case REG_TYPE_TEMP:
-            output_line(ctx, "float4 %s;", varname);
-            break;
-        case REG_TYPE_LOOP:
-            break; // no-op. We declare these in for loops at the moment.
-        case REG_TYPE_LABEL:
-            break; // no-op. If we see it here, it means we optimized it out.
-        default:

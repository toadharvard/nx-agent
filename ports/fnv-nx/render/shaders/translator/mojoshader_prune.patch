-const char *get_HLSL_comparison_string_scalar(Context *ctx)
-{
-    const char *comps[] = { "", ">", "==", ">=", "<", "!=", "<=" };
-    if (ctx->instruction_controls >= STATICARRAYLEN(comps))
-    {
-        fail(ctx, "unknown comparison control");
-        return "";

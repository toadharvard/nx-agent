-            return cl->id;
-        else if (v < cl->v.i)
-            break;
-        prev = cl;
-        cl = cl->next;
-    } // while
-    cl = spv_componentlist_alloc(ctx);
-    cl->next = prev->next;
-    prev->next = cl;
-    cl->v.i = v;
-    cl->id = spv_output_scalar(ctx, cl, MOJOSHADER_ATTRIBUTE_INT);

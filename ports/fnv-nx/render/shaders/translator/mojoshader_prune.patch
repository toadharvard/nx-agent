-       (src.tid == ctx->spirv.tid[STI_VEC4]) ? STI_BVEC4 :
-       (src.tid == ctx->spirv.tid[STI_VEC3]) ? STI_BVEC3 :
-       (src.tid == ctx->spirv.tid[STI_VEC2]) ? STI_BVEC2 : STI_BOOL;

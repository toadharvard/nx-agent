-
-    snprintf(buf, buflen, "%s%s%s%s%s%s%s%s%s%s", premod_str,
-             regtype_str, regnum_str, rel_lbracket,
-             rel_regtype_str, rel_swizzle, rel_offset, rel_rbracket,

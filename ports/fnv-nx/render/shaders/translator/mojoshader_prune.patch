-            } // if
-            else
-            {
-                regtype_str = get_METAL_uniform_array_varname(ctx, arg->regtype,
-                                                      (char *) alloca(64), 64);
-                if (offset == 0)
-                {
-                    snprintf(rel_offset, sizeof (rel_offset),

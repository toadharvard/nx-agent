-void emit_SPIRV_attribute(Context *ctx, RegisterType regtype, int regnum,
-                          MOJOSHADER_usage usage, int index, int wmask,
-                          int flags)
-{
-    uint32 tid;
-    RegisterList *r = spv_getreg(ctx, regtype, regnum);
-
-    ctx->spirv.inoutcount += 1;
-

-
-        case SRCMOD_COMPLEMENT:
-            premod_str = "(1.0 - ";
-            postmod_str = ")";
-            break;
-
-        case SRCMOD_X2NEGATE:
-            premod_str = "-(";
-            postmod_str = " * 2.0)";
-            break;
-
-        case SRCMOD_X2:
-            premod_str = "(";
-            postmod_str = " * 2.0)";

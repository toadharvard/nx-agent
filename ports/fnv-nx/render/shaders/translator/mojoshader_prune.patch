-    {
-        case SRCMOD_NEGATE:
-            premod_str = "-";
-            break;
-
-        case SRCMOD_BIASNEGATE:
-            premod_str = "-(";
-            postmod_str = " - 0.5)";
-            break;
-
-        case SRCMOD_BIAS:
-            premod_str = "(";
-            postmod_str = " - 0.5)";
-            break;
-
-        case SRCMOD_SIGNNEGATE:

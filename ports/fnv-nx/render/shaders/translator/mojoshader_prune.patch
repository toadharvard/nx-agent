-        regnum_str[0] = '\0'; // move value to scratch register.
-        rel_lbracket = "";   // scratch register won't use array.
-        rel_rbracket = "";
-        rel_offset[0] = '\0';
-        rel_swizzle[0] = '\0';
-        rel_regtype_str = "";
-    } // if
-
-    const char *premod_str = "";
-    const char *postmod_str = "";
-    switch (mod)
-    {
-        case SRCMOD_NEGATE:
-            premod_str = "-";
-            break;
-
-        case SRCMOD_BIASNEGATE:
-            premod_str = "-";
-            // fall through.
-        case SRCMOD_BIAS:
-            output_line(ctx, "SUB %s, %s, { 0.5, 0.5, 0.5, 0.5 };",

-    else if (ctx->instruction_controls == CONTROL_TEXLDP)
-        arb1_texld(ctx, "TXP", 0);
-    else if (ctx->instruction_controls == CONTROL_TEXLDB)
-        arb1_texld(ctx, "TXB", 0);

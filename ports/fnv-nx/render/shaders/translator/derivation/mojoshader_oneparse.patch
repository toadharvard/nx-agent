+#if SUPPORT_PROFILE_GLSLDK
+// fnv-nx: the locations of the glsldk profile, computed ONCE at the start of the definitions phase, when every instruction is parsed and the
+//  register lists are complete (see mojoshader.h, MOJOSHADER_glsldkConfig). Rule: fnvnx_dk_assign() over the DECLARED set: the context's own
+//  attribute list (inputs: every non-output register; outputs: RASTOUT / ATTROUT / TEXCRDOUT (= vs_3_0 o#) / COLOROUT / DEPTHOUT) plus the link set.
+//  A register is classified by its type, never by its name. An illegal declaration (usage / index outside the D3D9 range, duplicates, more
+//  pairs than slots) is a rejection of the program.
+static int dk_is_output_reg(RegisterType t)
+{
+    return (t == REG_TYPE_RASTOUT) || (t == REG_TYPE_ATTROUT) || (t == REG_TYPE_TEXCRDOUT) || (t == REG_TYPE_COLOROUT) || (t == REG_TYPE_DEPTHOUT);
+} // dk_is_output_reg
+
+static void dk_locate(Context *ctx)
+{
+    const MOJOSHADER_glsldkConfig *dk = ctx->dk;
+    const int is_vs = shader_is_vertex(ctx);
+    unsigned char set[224];
+    signed char loc[224];
+    int n = 0, i;
+    const RegisterList *r;
+    unsigned int k;
+
+    memset(dk->attrib, -1, 224);
+    memset(dk->varying, -1, 224);
+    memset(dk->copy, 0, 224);
+
+    #define DK_ADD(pr) do { int dup_ = 0; for (int q_ = 0; q_ < n; q_++) if (set[q_] == (pr)) dup_ = 1; if (!dup_) set[n++] = (unsigned char)(pr); } while (0)
+    for (r = ctx->attributes.next; r != NULL; r = r->next)  // inputs: a VS's are attributes, a PS's are varyings
+    {
+        const int usage = (int) r->usage;
+        if (dk_is_output_reg(r->regtype))
+            continue;
+        if (!is_vs && (usage < 0))
+            continue;  // vPos / vFace: not interpolants
+        if ((usage < 0) || (usage > 13) || (r->index < 0) || (r->index > 15))
+        {
+            failf(ctx, "glsldk: input usage %d index %d outside the D3D9 range", usage, r->index);
+            return;
+        } // if
+        DK_ADD(FNVNX_DK_PAIR(usage, r->index));
+    } // for
+    if (is_vs)
+    {
+        if (fnvnx_dk_assign(FNVNX_DK_KIND_ATTRIB, set, n, loc))
+        {
+            fail(ctx, "glsldk: the vertex inputs are not a legal declaration set (duplicate or more than 16)");
+            return;
+        } // if
+        for (i = 0; i < n; i++)
+            dk->attrib[set[i]] = loc[i];
+        n = 0;
+    } // if
+    else
+    {
+        for (r = ctx->attributes.next; r != NULL; r = r->next)
+            if (!dk_is_output_reg(r->regtype) && ((int) r->usage >= 0))
+                DK_ADD(FNVNX_DK_PAIR((int) r->usage, r->index));
+    } // else
+    if (is_vs)
+    {
+        for (r = ctx->attributes.next; r != NULL; r = r->next)  // outputs (index of a vs < 3.0 oFog / oPts: 0, the one fog / point size per vertex)
+        {
+            if (!dk_is_output_reg(r->regtype))
+                continue;
+            const int usage = (int) r->usage;
+            const int idx = ((ctx->major_ver < 3) && ((usage == MOJOSHADER_USAGE_FOG) || (usage == MOJOSHADER_USAGE_POINTSIZE))) ? 0 : r->index;
+            if ((usage < 0) || (usage > 13) || (idx < 0) || (idx > 15))
+            {
+                failf(ctx, "glsldk: output usage %d index %d outside the D3D9 range", usage, r->index);
+                return;
+            } // if
+            if ((idx == 0) && ((usage == MOJOSHADER_USAGE_POSITION) || (usage == MOJOSHADER_USAGE_POINTSIZE)))
+                continue;  // built-ins gl_Position / gl_PointSize
+            DK_ADD(FNVNX_DK_PAIR(usage, idx));
+        } // for
+    } // if
+    for (k = 0; k < dk->nlink; k++)
+    {
+        if (dk->link[k] / 16 > 13)
+        {
+            failf(ctx, "glsldk: link pair %u outside the D3D9 range", (unsigned int) dk->link[k]);
+            return;
+        } // if
+        if (n < 224)
+            DK_ADD(dk->link[k]);
+    } // for
+    #undef DK_ADD
+    if (fnvnx_dk_assign(FNVNX_DK_KIND_VARYING, set, n, loc))
+    {
+        fail(ctx, "glsldk: the varyings are not a legal declaration set (duplicate or more than 31)");
+        return;
+    } // if
+    for (i = 0; i < n; i++)
+        dk->varying[set[i]] = loc[i];
+    for (k = 0; k < dk->nlink; k++)
+        if ((dk->link[k] == FNVNX_DK_PAIR(MOJOSHADER_USAGE_POSITION, 0)) || (dk->link[k] == FNVNX_DK_PAIR(MOJOSHADER_USAGE_POINTSIZE, 0)))
+            dk->copy[dk->link[k]] = 1;
+} // dk_locate
+#endif

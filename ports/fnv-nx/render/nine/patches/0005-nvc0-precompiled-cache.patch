+/* fnv-nx 0005: (de)serialisation of fixup tables for the program cache.
+ * A fixup entry is (apply function, packed ipa/reg/loc); the function is stored as
+ * (emitter family << 8 | index), stable across processes and hosts. */
+typedef nv50_ir::FixupApply (*FixupTableFn)(unsigned int);
+static const FixupTableFn fixupTables[] = {
+   NULL,
+   nv50_ir::getFixupApplyGM107,
+   nv50_ir::getFixupApplyGK110,
+#ifndef __SWITCH__
+   nv50_ir::getFixupApplyNVC0,
+#endif
+};
+#define NUM_FIXUP_TABLES (sizeof(fixupTables) / sizeof(fixupTables[0]))
+
+int
+nv50_ir_fixups_serialize(const void *fixupData, uint32_t *out, uint32_t max)
+{
+   const nv50_ir::FixupInfo *info =
+      reinterpret_cast<const nv50_ir::FixupInfo *>(fixupData);
+   if (!info)
+      return 0;
+   if (info->count > max)
+      return -1;
+   for (unsigned i = 0; i < info->count; ++i) {
+      int id = -1;
+      for (unsigned t = 1; t < NUM_FIXUP_TABLES && id < 0; ++t) {
+         nv50_ir::FixupApply f;
+         for (unsigned k = 0; (f = fixupTables[t](k)); ++k)
+            if (f == info->entry[i].apply) {
+               id = (t << 8) | k;
+               break;
+            }
+      }
+      if (id < 0)
+         return -1;
+      out[2 * i + 0] = id;
+      out[2 * i + 1] = info->entry[i].val;
+   }
+   return info->count;
+}
+
+void *
+nv50_ir_fixups_deserialize(const uint32_t *in, uint32_t count)
+{
+   nv50_ir::FixupInfo *info = reinterpret_cast<nv50_ir::FixupInfo *>(
+      MALLOC(sizeof(nv50_ir::FixupInfo) + count * sizeof(nv50_ir::FixupEntry)));
+   if (!info)
+      return NULL;
+   info->count = count;
+   for (unsigned i = 0; i < count; ++i) {
+      unsigned t = in[2 * i] >> 8, k = in[2 * i] & 0xff;
+      nv50_ir::FixupApply f = NULL;
+      if (t >= 1 && t < NUM_FIXUP_TABLES)
+         f = fixupTables[t](k);
+      if (!f) {
+         FREE(info);
+         return NULL;
+      }
+      info->entry[i] = nv50_ir::FixupEntry(f, 0, 0, 0);
+      info->entry[i].val = in[2 * i + 1];
+   }
+   return info;
+}
+
+/* fnv-nx 0005: relocation table <-> 5 words per entry (data, mask, offset, bitPos, type).
+ * codePos/libPos/dataPos are written by nv50_ir_relocate_code at upload, so they are not stored. */
+uint32_t
+nv50_ir_relocs_count(const void *relocData)
+{
+   const nv50_ir::RelocInfo *info =
+      reinterpret_cast<const nv50_ir::RelocInfo *>(relocData);
+   return info ? info->count : 0;
+}
+
+void
+nv50_ir_relocs_serialize(const void *relocData, uint32_t *out)
+{
+   const nv50_ir::RelocInfo *info =
+      reinterpret_cast<const nv50_ir::RelocInfo *>(relocData);
+   for (unsigned i = 0; info && i < info->count; ++i) {
+      const nv50_ir::RelocEntry *e = &info->entry[i];
+      out[5 * i + 0] = e->data;
+      out[5 * i + 1] = e->mask;
+      out[5 * i + 2] = e->offset;
+      out[5 * i + 3] = (uint32_t)(int32_t)e->bitPos;
+      out[5 * i + 4] = (uint32_t)e->type;
+   }
+}
+
+void *
+nv50_ir_relocs_deserialize(const uint32_t *in, uint32_t count)
+{
+   nv50_ir::RelocInfo *info = reinterpret_cast<nv50_ir::RelocInfo *>(
+      CALLOC(1, sizeof(nv50_ir::RelocInfo) + count * sizeof(nv50_ir::RelocEntry)));
+   if (!info)
+      return NULL;
+   info->count = count;
+   for (unsigned i = 0; i < count; ++i) {
+      nv50_ir::RelocEntry *e = &info->entry[i];
+      if (in[5 * i + 4] > nv50_ir::RelocEntry::TYPE_DATA) {
+         FREE(info);
+         return NULL;
+      }
+      e->data = in[5 * i + 0];
+      e->mask = in[5 * i + 1];
+      e->offset = in[5 * i + 2];
+      e->bitPos = (int8_t)(int32_t)in[5 * i + 3];
+      e->type = (nv50_ir::RelocEntry::Type)in[5 * i + 4];
+   }
+   return info;
+}

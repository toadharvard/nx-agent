+/* fnv-nx 0006: Mesa 20.1 emitted TGSI CAL with a label slot that did not exist for a call before its
+ * label (inst_labels was grown one short and num_inst_labels never set), no BGNSUB/ENDSUB, and dropped
+ * the subroutine's last ret; nv50_ir crashed on the result. D3D9 forbids recursion and limits call
+ * nesting (4 in vs/ps 3.0), so the translator now inlines the label body at every call site: the
+ * TGSI is straight-line code with ordinary IF/LOOP, which every driver handles. */
+#define NINE_MAX_INLINE_DEPTH 8
+
+static void sm1_parse_instruction(struct shader_translator *tx);
+
+/* first instruction token of "label l<n>", or NULL. SM2+ only: instruction lengths are encoded. */
+static const DWORD *
+tx_find_label(struct shader_translator *tx, unsigned n)
+{
+    const DWORD *p = tx->byte_code + 1;
+    if (tx->version.major < 2)
+        return NULL;
+    while (*p != NINED3DSP_END) {
+        const DWORD tok = *p;
+        if ((tok & D3DSI_OPCODE_MASK) == D3DSIO_COMMENT) {
+            p += 1 + ((tok & D3DSI_COMMENTSIZE_MASK) >> D3DSI_COMMENTSIZE_SHIFT);
+            continue;
+        }
+        if ((tok & D3DSI_OPCODE_MASK) == D3DSIO_LABEL && (p[1] & D3DSP_REGNUM_MASK) == n)
+            return p;
+        p += 1 + ((tok & D3DSI_INSTLENGTH_MASK) >> D3DSI_INSTLENGTH_SHIFT);
+    }
+    return NULL;
+}
+
+/* translate the body of label l<n> here, then continue after the call instruction */
+static HRESULT
+tx_inline_call(struct shader_translator *tx, unsigned n)
+{
+    const DWORD *label = tx_find_label(tx, n);
+    const struct sm1_instruction insn = tx->insn;
+    const DWORD *parse = tx->parse, *parse_next = tx->parse_next;
+    const unsigned num_scratch = tx->num_scratch;
+    const unsigned cond_depth = tx->inline_cond_depth, loop_depth = tx->inline_loop_depth;
+    HRESULT hr = D3D_OK;
+
+    if (!label || tx->inline_depth >= NINE_MAX_INLINE_DEPTH || tx->insn.predicated)
+        return D3DERR_INVALIDCALL;
+
+    tx->parse = label + 1 + ((*label & D3DSI_INSTLENGTH_MASK) >> D3DSI_INSTLENGTH_SHIFT);
+    tx->inline_depth++;
+    tx->inline_cond_depth = tx->cond_depth;
+    tx->inline_loop_depth = tx->loop_depth;
+    tx->sub_ret = FALSE;
+    while (!tx->sub_ret && !tx->failure && *tx->parse != NINED3DSP_END)
+        sm1_parse_instruction(tx);
+    if (tx->failure || tx->cond_depth != tx->inline_cond_depth ||
+        tx->loop_depth != tx->inline_loop_depth)
+        hr = D3DERR_INVALIDCALL;
+    tx->sub_ret = FALSE;
+    tx->inline_depth--;
+    tx->inline_cond_depth = cond_depth;
+    tx->inline_loop_depth = loop_depth;
+
+    tx->insn = insn;
+    tx->parse = parse;
+    tx->parse_next = parse_next;
+    tx->num_scratch = num_scratch;
+    return hr;
+}

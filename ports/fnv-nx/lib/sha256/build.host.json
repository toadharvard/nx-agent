{
 "format": "fnvnx-recipe/1",
 "compiler": {
  "cc": "x86_64-linux-gnu-gcc-13",
  "cxx": "x86_64-linux-gnu-g++-13"
 },
 "flags": {
  "c": [
   "-fms-extensions",
   "-fshort-wchar",
   "-frounding-math",
   "-fsigned-char",
   "-fno-strict-aliasing",
   "-fwrapv",
   "-fno-delete-null-pointer-checks",
   "-fno-lifetime-dse",
   "-ffp-contract=off",
   "-O2",
   "-Werror=attributes",
   "-Wall",
   "-Wextra",
   "-Wshadow",
   "-Wconversion",
   "-Wno-sign-conversion",
   "-Werror",
   "-std=c99",
   "-fPIC"
  ],
  "cxx": [
   "-fPIC"
  ],
  "asm": []
 },
 "include": [
  "ports/fnv-nx/lib/sha256/include"
 ],
 "units": "all"
}

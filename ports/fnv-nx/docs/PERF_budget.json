{
 "schema": "fnvnx-frame-budget/1",
 "inputs": {
  "model": "fnvnx-budget-model/1",
  "scene": "exterior, Mojave wasteland, ~2,500 draws (RENDER_NATIVE draw counts), native renderer",
  "frameprof": true,
  "render": true
 },
 "assumptions": [
  {
   "id": "ipc",
   "value": 0.8,
   "range": [
    0.6,
    1.0
   ],
   "unit": "instructions/cycle",
   "basis": "E",
   "note": "A57 on pointer-chasing engine code; SPEC CPU2006 int on A57-class cores ~1.0-1.2, games lower. Replaced by benchmark B1 (PERF.md 9) on hardware."
  },
  {
   "id": "clocks_mhz",
   "value": [
    1020,
    1785
   ],
   "unit": "MHz",
   "basis": "M",
   "note": "Switch CPU: 1020 MHz stock (docked and handheld); 1785 MHz boost (the owner's console can run it, J-0132)."
  },
  {
   "id": "app_cores",
   "value": 3,
   "unit": "cores",
   "basis": "M",
   "note": "cores 0-2 for the application; core 3 is the system's, usable with the core3=1 opt-in (S5 33c0b1b)."
  },
  {
   "id": "parallel_efficiency",
   "value": 0.85,
   "range": [
    0.7,
    0.95
   ],
   "unit": "fraction",
   "basis": "E",
   "note": "work moved off the main thread runs this much as fast on a worker core (cold caches, hand-off waits, migration inside the 0b110 mask)."
  },
  {
   "id": "sync_overhead_minsn",
   "value": 0.3,
   "range": [
    0.1,
    0.6
   ],
   "unit": "M instructions on main",
   "basis": "E",
   "note": "per-frame hand-offs: ~20 events, the AI spin lock 0x011f11a0, stage semaphores (PERF.md 6.1); B3 measures it."
  },
  {
   "id": "worst_frame_factor",
   "value": 1.25,
   "range": [
    1.1,
    1.5
   ],
   "unit": "x",
   "basis": "E",
   "note": "worst frame / mean frame for 'stable' targets (cell streaming, AI bursts, Havok contacts). 45 fps stable means the worst frame fits 22.2 ms."
  }
 ],
 "targets": [
  {
   "id": "fail_below_30",
   "fps": 30,
   "ms": 33.3,
   "kind": "floor",
   "note": "below 30 fps is a fail (J-0132)"
  },
  {
   "id": "pass_45",
   "fps": 45,
   "ms": 22.2,
   "kind": "goal",
   "note": "45 fps stable: worst frame 22.2 ms (main target, J-0132)"
  },
  {
   "id": "stretch_60",
   "fps": 60,
   "ms": 16.7,
   "kind": "stretch",
   "note": "60 fps, may be unstable (J-0132)"
  }

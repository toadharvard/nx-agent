  "external": "gcc-msvcmodel",
  "cc": "bin/aarch64-linux-gnu-gcc",
  "cxx": "bin/aarch64-linux-gnu-g++"
 },
 "flags": {
  "c": [
   "-O2",
   "-g",
   "-Wall",
   "-Wextra",
   "-Werror=attributes",
   "-DMODE=0"
  ],
  "cxx": [
   "-O2",
   "-g",
   "-ffunction-sections",
   "-fdata-sections",
   "-Wall",
   "-Wextra",
   "-D__LINUX_ERRNO_EXTENSIONS__",
   "-DFNVNX_SDD=1",
   "-std=gnu++20",
   "-Werror=attributes"
  ],
  "asm": []
 },

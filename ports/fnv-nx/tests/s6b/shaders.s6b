mov oD0, r0
mov oPts, c5.x

=== vs20_call
// SM2.0 VS: call/label/ret subroutine, sincos, expp/logp, frc, sge/slt
// expect: void vs_l0()
vs_2_0
def c10, -1.5500992e-006, -2.1701389e-005, 0.0026041667, 0.00026041668
def c11, -0.020833334, -0.125, 1.0, 0.5
dcl_position v0
dcl_texcoord v1
mov r2, c11.z
call l0
m4x4 oPos, v0, c0
mov oD0, r2
ret
label l0
sincos r2.xy, v1.x, c10, c11
frc r3, v1
sge r2.z, v1.y, c11.w
slt r2.w, v1.y, c11.w
expp r4, v1.z
logp r4.y, r4.x
add r2, r2, r3
ret


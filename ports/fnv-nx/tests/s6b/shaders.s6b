// tests/s6b shader corpus (authored for this project; no game content).
// Sections start with "=== name"; run.sh splits them, assembles each with s6b_asm,
// packs them into synthetic .sdp packages and runs sdp2dksh. Directives in comments:
//   // ctab: NAME SET REG COUNT CLASS TYPE ROWS COLS   CTAB symbol embedded by s6b_asm
//   // expect: TEXT          generated GLSL must contain TEXT
//   // json: TEXT            reflection JSON must contain TEXT
//   // expect-fail: TEXT     translation must fail with an error containing TEXT (known gap)

=== vs11_basic
// SM1.1 VS: dcl semantics, m4x4 -> oPos, oD0/oD1, oT0/oT1, oFog, CTAB
// ctab: WorldViewProj float 0 4 matrix_rows float 4 4
// ctab: FogParams float 4 1 vector float 1 4
// expect: layout(location = 0) in vec4 vs_v0;
// expect: layout(location = 4) in vec4 vs_v1;
// expect: layout(location = 6) in vec4 vs_v2;
// expect: layout(location = 0) out highp vec4 io_10_0;
// expect: layout(location = 1) out highp vec4 io_10_1;
// expect: layout(location = 2) out highp vec4 io_5_0;
// expect: layout(location = 18) out
// expect: uniform vs_cbuf_f
// expect: vs_drv_posfix
// json: "WorldViewProj"
// json: "usage": "COLOR"
vs_1_1
dcl_position v0
dcl_color v1
dcl_texcoord v2
m4x4 oPos, v0, c0
mov oD0, v1
mov oD1, v1.zyxw
mov oT0, v2
mul oT1.xy, v2, c4
dp4 r0.x, v0, c2
mad oFog, r0.x, c4.x, c4.y

=== vs11_reladdr
// SM1.1 VS: a0 relative addressing (skinning palette), def literals, normal/blend semantics
// ctab: Bones float 10 30 matrix_rows float 3 4
// expect: ARRAYBASE_
// expect: layout(location = 2) in vec4
// expect: layout(location = 3) in vec4
vs_1_1
def c9, 3.0, 0.0, 1.0, 0.5
dcl_position v0
dcl_blendindices v1
dcl_normal v2
mul r1.x, v1.x, c9.x
mov a0.x, r1.x
dp4 r0.x, v0, c[a0.x + 10]
dp4 r0.y, v0, c[a0.x + 11]
dp4 r0.z, v0, c[a0.x + 12]
mov r0.w, c9.z
m4x4 oPos, r0, c0
dp3 oT0.x, v2, c[a0.x + 10]
mov oT0.yzw, c9.yyz


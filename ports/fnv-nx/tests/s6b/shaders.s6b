loop aL, i0
dp3 r1.x, v1, c[aL + 8]
max r1.x, r1.x, c4.x
add r0, r0, r1.x
endloop
rep i1
add r0.y, r0.y, c4.w
endrep
if b0
mov oT7, r0
else
mov oT7, c4.zzzz
endif

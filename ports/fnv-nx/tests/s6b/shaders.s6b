=== vs20_numerics
// P3/P4/6: Nine's D3D9 numerics on a driver without MUL_ZERO_WINS (softpipe):
// log/logp = max(-FLT_MAX, log2|x|), rcp clamped to +-FLT_MAX/2, rsq to FLT_MAX, nrm 3-component with
// rsq clamped (nrm(0) = 0), min/max as a < b ? a : b
// expect: float dk_log(float x) { float a = abs(x); float t = log2(a); return mix(t, -dk_FLT_MAX, a == 0.0 || -dk_FLT_MAX > t); }
// expect: const float dk_FLT_MAX = uintBitsToFloat(0x7f7fffffu);
// expect: const float dk_FLT_HALF = uintBitsToFloat(0x7effffffu);
// expect: vs_r0.x = (dk_log(vs_c0.x));
// expect: vs_r0.y = (dk_log(vs_c0.y));
// expect: vs_r1 = vec4(dk_rcp(vs_c0.z));
// expect: vs_r2.xy = vec2(dk_rsq(vs_c0.w));
// expect: vs_r3 = vs_c1 * dk_nrm(vs_c1.xyz);
// expect: vs_r4.xyz = vs_c1.xyz * dk_nrm(vs_c1.xyz);
// expect: vs_r5 = mix(vs_c1, vs_c0, lessThan(vs_c0, vs_c1));
// expect: vs_r6.x = ((vs_c0.x > vs_c1.x) ? vs_c0.x : vs_c1.x);
// expect-not: normalize(
// expect-not: = log2(vs_
vs_2_0
dcl_position v0
mov oPos, v0
log r0.x, c0.x
logp r0.y, c0.y
rcp r1, c0.z
rsq r2.xy, c0.w
nrm r3, c1
nrm r4.xyz, c1
min r5, c0, c1
max r6.x, c0.x, c1.x
add r0, r0, r1
add r0, r0, r2
add r0, r0, r3
add r0, r0, r4
add r0, r0, r5
add oT0, r0, r6.x


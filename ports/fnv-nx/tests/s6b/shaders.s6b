=== vs20_flow
// SM2.0 VS: loop aL/i#, rep, if b#/else, relative c[aL], int/bool constants, oPts, oT7
// ctab: Lights float 8 8 vector float 1 4
// ctab: NumLights int 0 1 scalar int 1 1
// ctab: UseFog bool 0 1 scalar bool 1 1
// expect: uniform vs_cbuf_ib
// expect: for (
// expect: gl_PointSize
// expect: if (vs_b0)
// json: "set": "int"
// json: "set": "bool"
vs_2_0
defi i1, 3, 0, 1, 0
dcl_position v0
dcl_normal v1
mov r0, c4.x
loop aL, i0
dp3 r1.x, v1, c[aL + 8]
max r1.x, r1.x, c4.x
add r0, r0, r1.x
endloop
rep i1
add r0.y, r0.y, c4.w
endrep
if b0
mov oT7, r0
else
mov oT7, c4.zzzz
endif
m4x4 oPos, v0, c0
mov oD0, r0
mov oPts, c5.x

=== vs20_call
// SM2.0 VS: call/label/ret subroutine, sincos, expp/logp, frc, sge/slt
// expect: void vs_l0()
vs_2_0
def c10, -1.5500992e-006, -2.1701389e-005, 0.0026041667, 0.00026041668
def c11, -0.020833334, -0.125, 1.0, 0.5
dcl_position v0
dcl_texcoord v1
mov r2, c11.z
call l0
m4x4 oPos, v0, c0
mov oD0, r2
ret
label l0
sincos r2.xy, v1.x, c10, c11
frc r3, v1
sge r2.z, v1.y, c11.w
slt r2.w, v1.y, c11.w
expp r4, v1.z
logp r4.y, r4.x
add r2, r2, r3
ret

=== vs30_full
// SM3.0 VS: dcl'd outputs, vertex texture fetch (texldl), predicates, break_gt, tangent/binormal
// ctab: HeightMap sampler 0 1 object sampler2d 1 1
// expect: layout(binding = 0) uniform sampler2D vs_s0;
// expect: texture2DLod(
// expect: layout(location = 14) in vec4
// expect: layout(location = 15) in vec4
// expect: layout(location = 21) out highp vec4 io_6_0;
// expect: bvec4 vs_p0;
// json: "type": "2d"
vs_3_0
def c10, 0.0, 1.0, 0.5, 8.0
defi i0, 8, 0, 1, 0
dcl_position v0
dcl_texcoord v1
dcl_tangent v2
dcl_binormal v3
dcl_2d s0
dcl_position o0
dcl_texcoord0 o1
dcl_tangent o2
dcl_color o3
mov r1, v1
mov r1.zw, c10.x
texldl r0, r1, s0
mad r2, r0.x, c10.z, v0
setp_gt p0, r0.x, c10.z
(p0) mov r2.y, c10.y
(!p0) mov r2.y, c10.x
mov r3, c10.x
loop aL, i0
add r3.x, r3.x, c10.y
break_gt r3.x, c10.w
endloop
m4x4 o0, r2, c0
mov o1, v1
crs r4.xyz, v2, v3
mov r4.w, c10.y
mov o2, r4
mov o3, r3


dcl t1.xyz
dcl t2.xyz
dcl v0
dcl_2d s0
dcl_cube s1
dcl_volume s2
texkill t0
texld r0, t0, s0
texld r1, t1, s1
texld r2, t2, s2
texldp r3, t0, s0
texldb r4, t0, s0
mul r0, r0, r1
mad r0, r2, r3, r0
add r0, r0, r4
mul r0, r0, v0
mov oC0, r0

=== ps20_math
// SM2.0 PS: rcp/rsq/pow/exp/log/nrm/dp2add/abs/cmp/lrp, sat/x2 modifiers, oDepth
// expect: gl_FragDepth
ps_2_0
def c1, 0.5, 2.0, 0.25, 1.0
dcl t0
dcl v0
rcp r0.x, t0.x
rsq r0.y, t0.y
pow r0.z, t0.z, c1.y
exp r0.w, t0.w
log r1.x, t0.x
nrm r2.xyz, t0
dp2add r1.y, t0, c1, c1.z
abs r1.z, t0.z
cmp r1.w, t0.x, c1.x, c1.y
lrp_sat r3, c1.x, r0, r2
mul r3, r3, v0
mov oC0, r3
mov oDepth, r1.x

=== ps30_full
// SM3.0 PS: dcl_texcoord/dcl_color v#, vPos, vFace, loop, if_gt, dsx/dsy, texldd/texldl,
//           predicates, MRT oC0/oC1, relative c[aL]
// ctab: Kernel float 16 8 vector float 1 4
// expect: gl_FragCoord.xy - vec2(0.5)
// expect: gl_FrontFacing
// expect: dFdx(
// expect: texture2DGrad(
// expect: layout(location = 1) out highp vec4 _gl_FragData_1;
// expect: layout(location = 3) in highp vec4 io_5_1;
ps_3_0
def c0, 0.0, 1.0, 0.5, 0.125
defi i0, 8, 0, 1, 0
dcl_texcoord0 v0
dcl_texcoord1 v1.xy
dcl_color0 v2
dcl vPos.xy
dcl vFace
dcl_2d s0
mov r0, c0.x
loop aL, i0
add r0, r0, c[aL + 16]
endloop
dsx r1, v0
dsy r2, v0
texldd r3, v0, s0, r1, r2
mov r4, v1
mov r4.zw, c0.x
texldl r5, r4, s0
setp_lt p0, v0, c0
(p0) mov r3, r5
if_gt vPos.x, c0.y
mul r3, r3, c0.z
endif
mul r0, r0, c0.w
mad oC0, r3, v2, r0
mov oC1, r5

=== ps30_predbreak
// SM3.0 PS: rep + break_ge, if_lt/else, setp + predicated add, cube sampler from a normal input
// expect: samplerCube
// expect: break;
ps_3_0
def c0, 0.0, 1.0, 0.5, 4.0
defi i0, 4, 0, 1, 0
dcl_texcoord0 v0
dcl_normal v1
dcl_cube s3
mov r0, c0.x
rep i0
add r0.x, r0.x, c0.y
setp_ge p0, r0, c0.w
(p0) add r0.y, r0.y, c0.y
break_ge r0.x, c0.w
endrep
if_lt v0.x, c0.z
texld r1, v1, s3
else
mov r1, c0.y
endif
mul oC0, r1, r0.x

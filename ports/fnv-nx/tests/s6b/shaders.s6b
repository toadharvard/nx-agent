// SM3.0 VS: dcl'd outputs, vertex texture fetch (texldl), predicates, break_gt, tangent/binormal
// ctab: HeightMap sampler 0 1 object sampler2d 1 1
// expect: layout(binding = 0) uniform sampler2D vs_s0;
// expect: texture2DLod(
// expect: layout(location = 14) in vec4
// expect: layout(location = 15) in vec4
// expect: layout(location = 21) out highp vec4 io_6_0;
// expect: bvec4 vs_p0;
// json: "type": "2d"
vs_3_0
def c10, 0.0, 1.0, 0.5, 8.0
defi i0, 8, 0, 1, 0
dcl_position v0
dcl_texcoord v1
dcl_tangent v2
dcl_binormal v3
dcl_2d s0
dcl_position o0
dcl_texcoord0 o1
dcl_tangent o2
dcl_color o3
mov r1, v1
mov r1.zw, c10.x
texldl r0, r1, s0
mad r2, r0.x, c10.z, v0
setp_gt p0, r0.x, c10.z
(p0) mov r2.y, c10.y
(!p0) mov r2.y, c10.x
mov r3, c10.x
loop aL, i0
add r3.x, r3.x, c10.y
break_gt r3.x, c10.w
endloop
m4x4 o0, r2, c0
mov o1, v1
crs r4.xyz, v2, v3
mov r4.w, c10.y
mov o2, r4
mov o3, r3


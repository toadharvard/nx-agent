// SM1.1 PS: tex t#, modulate with v0, r0 output, co-issue, fog/alpha epilogue, sampler bindings
// expect: layout(binding = 0) uniform sampler2D ps_s0;
// expect: layout(binding = 1) uniform sampler2D ps_s1;

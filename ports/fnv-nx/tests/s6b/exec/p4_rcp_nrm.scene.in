# P4: rcp(0) = FLT_MAX/2, rsq(0) = FLT_MAX, nrm(0) = 0, nrm is 3-component (w scaled too)
size 4 4
rt A32B32G32R32F
ds D24S8
clear 7 0xff000000 1.0 0
rs CULLMODE CULL_NONE
vs @p4_rcp_nrm
ps @p4_rcp_nrm_ps
vsc 0 0 0 0 1
vsc 1 3 0 4 2
vdecl 0:0
vg -1 1 0.5 1
vg 1 1 0.5 1
vg -1 -1 0.5 1
vg 1 1 0.5 1
vg 1 -1 0.5 1
vg -1 -1 0.5 1
drawg TRIANGLELIST 2

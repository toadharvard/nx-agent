# loop aL, i1 = (3, 4, 2): aL = 4, 6, 8
size 4 4
rt A32B32G32R32F
ds D24S8
clear 7 0xff000000 1.0 0
rs CULLMODE CULL_NONE
vs @loopstep
ps @tc
vsc 0 0.5 0.5 0.5 0.5
vsc 4 1 0 0 0
vsc 5 100 100 100 100
vsc 6 0 2 0 0
vsc 7 100 100 100 100
vsc 8 0 0 4 0
vsc 9 100 100 100 100
vsc 10 1000 1000 1000 1000
vdecl 0:0
vg -1 1 0.5 1
vg 1 1 0.5 1
vg -1 -1 0.5 1
vg 1 1 0.5 1
vg 1 -1 0.5 1
vg -1 -1 0.5 1
drawg TRIANGLELIST 2

# trap for V6N_MUTANT=separate_alpha (gen_scenes.py)
size 16 16
rt A8R8G8B8
ds D24S8
clear 7 0x40ff0000 1.0 0
rs CULLMODE CULL_NONE
tss 0 COLOROP TOP_SELECTARG1
tss 0 COLORARG1 TA_DIFFUSE
tss 0 ALPHAOP TOP_SELECTARG1
tss 0 ALPHAARG1 TA_DIFFUSE
rs ALPHABLENDENABLE 1
rs SRCBLEND BLEND_ONE
rs DESTBLEND BLEND_ZERO
rs SEPARATEALPHABLENDENABLE 1
rs SRCBLENDALPHA BLEND_ZERO
rs DESTBLENDALPHA BLEND_ONE
mode rhw
v 0 0 0.5 1 0xc000ff00 0 0 0
v 16 0 0.5 1 0xc000ff00 0 1 0
v 0 16 0.5 1 0xc000ff00 0 0 1
v 16 0 0.5 1 0xc000ff00 0 1 0
v 16 16 0.5 1 0xc000ff00 0 1 1
v 0 16 0.5 1 0xc000ff00 0 0 1
draw TRIANGLELIST 2

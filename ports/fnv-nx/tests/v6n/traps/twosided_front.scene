# trap for V6N_MUTANT=twosided_front (gen_scenes.py)
size 16 16
rt A8R8G8B8
ds D24S8
clear 7 0xff000000 1.0 0x10
rs CULLMODE CULL_NONE
tss 0 COLOROP TOP_SELECTARG1
tss 0 COLORARG1 TA_DIFFUSE
tss 0 ALPHAOP TOP_SELECTARG1
tss 0 ALPHAARG1 TA_DIFFUSE
rs STENCILENABLE 1
rs TWOSIDEDSTENCILMODE 1
rs STENCILPASS STENCILOP_REPLACE
rs STENCILREF 0x5a
rs CCW_STENCILPASS STENCILOP_INCR
mode rhw
v 0 0 0.5 1 0xffffffff 0 0 0
v 16 0 0.5 1 0xffffffff 0 1 0
v 0 16 0.5 1 0xffffffff 0 0 1
v 16 0 0.5 1 0xffffffff 0 1 0
v 16 16 0.5 1 0xffffffff 0 1 1
v 0 16 0.5 1 0xffffffff 0 0 1
draw TRIANGLELIST 2

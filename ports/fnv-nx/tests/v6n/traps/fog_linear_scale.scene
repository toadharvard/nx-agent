# trap for V6N_MUTANT=fog_linear_scale (gen_scenes.py)
size 16 16
rt A8R8G8B8
ds D24S8
clear 7 0xff000000 1.0 0
rs CULLMODE CULL_NONE
tss 0 COLOROP TOP_SELECTARG1
tss 0 COLORARG1 TA_DIFFUSE
tss 0 ALPHAOP TOP_SELECTARG1
tss 0 ALPHAARG1 TA_DIFFUSE
rs FOGENABLE 1
rs FOGTABLEMODE FOG_LINEAR
rs FOGSTART f:0.6
rs FOGEND f:0.8
rs FOGCOLOR 0xff00ff00
mode xyz
v -1 1 0.2 1 0xff800000 0 0 0
v 1 1 0.2 1 0xff800000 0 1 0
v -1 -1 0.2 1 0xff800000 0 0 1
v 1 1 0.2 1 0xff800000 0 1 0
v 1 -1 0.2 1 0xff800000 0 1 1
v -1 -1 0.2 1 0xff800000 0 0 1
draw TRIANGLELIST 2

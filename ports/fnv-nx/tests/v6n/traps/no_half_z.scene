# trap for V6N_MUTANT=no_half_z (gen_scenes.py)
size 16 16
rt A8R8G8B8
ds D24S8
clear 7 0xff000000 1.0 0
rs CULLMODE CULL_NONE
tss 0 COLOROP TOP_SELECTARG1
tss 0 COLORARG1 TA_DIFFUSE
tss 0 ALPHAOP TOP_SELECTARG1
tss 0 ALPHAARG1 TA_DIFFUSE
rs ZENABLE 1
mode xyz
v -1 1 -0.5 1 0xffff0000 0 0 0
v 1 1 -0.5 1 0xffff0000 0 1 0
v -1 -1 0.5 1 0xffff0000 0 0 1
v 1 1 -0.5 1 0xffff0000 0 1 0
v 1 -1 0.5 1 0xffff0000 0 1 1
v -1 -1 0.5 1 0xffff0000 0 0 1
draw TRIANGLELIST 2

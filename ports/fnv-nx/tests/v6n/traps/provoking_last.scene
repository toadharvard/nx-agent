# trap for V6N_MUTANT=provoking_last (gen_scenes.py)
size 16 16
rt A8R8G8B8
ds D24S8
clear 7 0xff000000 1.0 0
rs CULLMODE CULL_NONE
tss 0 COLOROP TOP_SELECTARG1
tss 0 COLORARG1 TA_DIFFUSE
tss 0 ALPHAOP TOP_SELECTARG1
tss 0 ALPHAARG1 TA_DIFFUSE
rs SHADEMODE SHADE_FLAT
mode rhw
v 1 1 0.5 1 0xffff0000 0 0 0
v 15 1 0.5 1 0xff00ff00 0 0 0
v 1 15 0.5 1 0xff0000ff 0 0 0
draw TRIANGLELIST 1

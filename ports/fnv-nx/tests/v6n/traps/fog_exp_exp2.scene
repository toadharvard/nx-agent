# trap for V6N_MUTANT=fog_exp_exp2 (gen_scenes.py)
size 16 16
rt A8R8G8B8
ds D24S8
clear 7 0xff000000 1.0 0
rs CULLMODE CULL_NONE
tss 0 COLOROP TOP_SELECTARG1
tss 0 COLORARG1 TA_DIFFUSE
tss 0 ALPHAOP TOP_SELECTARG1
tss 0 ALPHAARG1 TA_DIFFUSE
rs FOGENABLE 1
rs FOGTABLEMODE FOG_EXP
rs FOGDENSITY f:1.0

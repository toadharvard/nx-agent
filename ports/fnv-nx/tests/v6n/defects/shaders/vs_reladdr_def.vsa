// V6n defect vs_reladdr_def (synthetic, for S6b): a constant defined with def is the value of that register for
// every read, relative addressing included (Nine places local constants in the constant buffer, "lconstf";
// wined3d uploads them as uniforms when the shader uses relative addressing). S6b's dk_relc() does this, but a
// relative read based on a register the CTAB declares as an array (here a 2-register array at c3, as the engine's
// instancing shaders declare theirs) takes MojoShader's ARRAYBASE path and reads the constant buffer directly,
// both for the array's first register (uniforms[ARRAYBASE_3 + a0.x]: GRASS) and for a later one
// (uniforms[(ARRAYBASE_3 + 1) + a0.y]: DISTTREE, PARTICLE).
// a0 = (-1, -2): c3[a0.x] and c4[a0.y] are both c2, the def value (0.25, 0.5, 0.75, 1), so Nine gives their
// product (0.0625, 0.25, 0.5625, 1). The buffer's c2 is (0, 0, 0, 1): either form missing the def shows.
// ctab: InstanceData float 3 2 vector float 1 4
vs_2_0
def c2, 0.25, 0.5, 0.75, 1.0
dcl_position v0
mova a0.xy, c0
mov oPos, v0
mul r0, c3[a0.x], c4[a0.y]
mov oD0, r0

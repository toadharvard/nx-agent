// V6n parity driver VS (synthetic): drives every PS input - COLOR0/1, TEXCOORD0 = uv, TEXCOORD1..7 = affine in uv
vs_2_0
dcl_position v0
dcl_color v1
dcl_color1 v2
dcl_texcoord v3
mov oPos, v0
mov oD0, v1
mov oD1, v2
mov oT0, v3
mad oT1, v3.xyxy, c1, c9
mad oT2, v3.xyxy, c2, c10
mad oT3, v3.xyxy, c3, c11
mad oT4, v3.xyxy, c4, c12
mad oT5, v3.xyxy, c5, c13
mad oT6, v3.xyxy, c6, c14
mad oT7, v3.xyxy, c7, c15
mov oFog, v3.x

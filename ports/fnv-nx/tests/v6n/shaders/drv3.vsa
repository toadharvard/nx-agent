// V6n parity driver VS for ps_3_0 (synthetic): same outputs as drv2.vsa by semantic
vs_3_0
dcl_position v0
dcl_color v1
dcl_color1 v2
dcl_texcoord v3
dcl_position o0
dcl_color o1
dcl_color1 o2
dcl_texcoord0 o3
dcl_texcoord1 o4
dcl_texcoord2 o5
dcl_texcoord3 o6
dcl_texcoord4 o7
dcl_texcoord5 o8
dcl_texcoord6 o9
dcl_texcoord7 o10
mov o0, v0
mov o1, v1
mov o2, v2
mov o3, v3
mad o4, v3.xyxy, c1, c9
mad o5, v3.xyxy, c2, c10
mad o6, v3.xyxy, c3, c11
mad o7, v3.xyxy, c4, c12
mad o8, v3.xyxy, c5, c13
mad o9, v3.xyxy, c6, c14
mad o10, v3.xyxy, c7, c15

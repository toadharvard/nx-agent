# VS + PS + indexed draw: a perspective-free transform in c0..c3 (scale 0.8, shift), tint c4
size 16 16
rt A8R8G8B8
ds D24S8
clear 7 0xff102030 1.0 0
rs CULLMODE CULL_NONE
rs ZENABLE 1
tex 0 A8R8G8B8 8 8 1 hash 5
vs @xform_tint
ps @tex_mod
vsc 0 0.8 0 0 0.1
vsc 1 0 0.8 0 -0.05
vsc 2 0 0 1 0
vsc 3 0 0 0 1
vsc 4 1 0.5 0.25 1
mode xyz
v -1 1 0.25 1 0xffffffff 0 0.0117 0.0117
v 1 1 0.5 1 0xffff00ff 0 1.0117 0.0117
v -1 -1 0.5 1 0xff00ffff 0 0.0117 1.0117
v 1 -1 0.75 1 0xffffff00 0 1.0117 1.0117
drawidx TRIANGLELIST 2 0 1 2 1 3 2

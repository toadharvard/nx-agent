# texture format A16B16G16R16F sampled with POINT into a float target (gen_scenes.py)
size 16 16
rt A32B32G32R32F
ds NONE
clear 7 0xff000000 1.0 0
rs CULLMODE CULL_NONE
tss 0 COLOROP TOP_SELECTARG1
tss 0 COLORARG1 TA_DIFFUSE
tss 0 ALPHAOP TOP_SELECTARG1
tss 0 ALPHAARG1 TA_DIFFUSE
tex 0 A16B16G16R16F 8 8 1 hash 21
samp 0 MINFILTER TEXF_POINT
samp 0 MAGFILTER TEXF_POINT
tss 0 COLOROP TOP_SELECTARG1
tss 0 COLORARG1 TA_TEXTURE
tss 0 ALPHAOP TOP_SELECTARG1
tss 0 ALPHAARG1 TA_TEXTURE
mode rhw
v 0 0 0.5 1 0xffffffff 0 0 0
v 16 0 0.5 1 0xffffffff 0 1 0
v 0 16 0.5 1 0xffffffff 0 0 1
v 16 0 0.5 1 0xffffffff 0 1 0
v 16 16 0.5 1 0xffffffff 0 1 1
v 0 16 0.5 1 0xffffffff 0 0 1
draw TRIANGLELIST 2

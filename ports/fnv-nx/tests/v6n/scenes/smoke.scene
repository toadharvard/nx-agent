# smoke: clear, one RHW triangle (CW on screen), depth-tested quad, stencil replace
size 16 16
rt A8R8G8B8
ds D24S8
clear 7 0xff102030 1.0 0
rs ZENABLE 1
rs CULLMODE CULL_NONE
rs STENCILENABLE 1
rs STENCILPASS STENCILOP_REPLACE
rs STENCILREF 0x5a
tss 0 COLOROP TOP_SELECTARG1
tss 0 COLORARG1 TA_DIFFUSE
tss 0 ALPHAOP TOP_SELECTARG1
tss 0 ALPHAARG1 TA_DIFFUSE
mode rhw
v 2 2 0.25 1 0xffff0000 0 0 0
v 14 2 0.5 1 0xff00ff00 0 0 0
v 2 14 0.75 1 0x800000ff 0 0 0
draw TRIANGLELIST 1

// tests/s6d extra shader corpus (authored for this project; no game content). Same "=== name" format as
// tests/s6b/shaders.s6b, assembled with S6b's s6b_asm. These target what Gallium Nine's variant keys and
// nvc0's re-translation react to: fog, point size, shadow samplers, ps_1_x sampler types, clip planes,
// integer/bool constants, vertex texture fetch, vFace/vPos, gradients, loops. Shapes follow common
// Gamebryo-era effects (skinning, normal map + shadow map, fog), written from scratch.

=== vs20_skin
// SM2.0 VS: 2-bone palette skinning through a0 (mova), normal transform, fog, two texcoords
vs_2_0
def c95, 3.0, 1.0, 0.0, 0.5
dcl_position v0
dcl_blendweight v1
dcl_blendindices v2
dcl_normal v3
dcl_texcoord v4
mul r0.xy, v2, c95.x
mova a0.xy, r0
m4x3 r1.xyz, v0, c[a0.x + 10]
m4x3 r2.xyz, v0, c[a0.y + 10]
mul r1.xyz, r1, v1.x
mad r1.xyz, r2, v1.y, r1
mov r1.w, c95.y
m3x3 r3.xyz, v3, c[a0.x + 10]
nrm r4.xyz, r3
m4x4 oPos, r1, c0
dp3 oT1.x, r4, c4
dp3 oT1.y, r4, c5
dp3 oT1.z, r4, c6
mov oT0, v4
dp4 r5.x, r1, c2
mad oFog, r5.x, c7.x, c7.y

=== ps20_normalmap_shadow
// SM2.0 PS: normal map lighting + projected shadow map lookup (sampler 2 is the shadow-sampler candidate)
ps_2_0
def c3, 2.0, -1.0, 0.0, 1.0
dcl t0.xy
dcl t1.xyz
dcl t2
dcl_2d s0
dcl_2d s1
dcl_2d s2
texld r0, t0, s0
texld r1, t0, s1
texldp r2, t2, s2
mad r1.xyz, r1, c3.x, c3.y
nrm r3.xyz, t1
dp3_sat r4.x, r1, r3
mul r4.x, r4.x, r2.x
mad r5.xyz, r0, r4.x, c1
mul r5.xyz, r5, c2
mov r5.w, r0.w
mov oC0, r5

=== ps20_texkill_lrp
// SM2.0 PS: texkill, cmp, lrp, pow, rcp (alpha-tested foliage style)
ps_2_0
def c4, 0.5, 0.0, 1.0, 8.0
dcl t0.xy
dcl v0
dcl_2d s0
dcl_cube s1
dcl t1.xyz
texld r0, t0, s0
sub r1, r0.w, c4.x
texkill r1
texld r2, t1, s1
lrp r3, c0.x, r2, r0
pow r4.x, r0.x, c4.w
rcp r4.y, c1.x
cmp r3.w, r1.x, r4.x, r4.y
mul r3.xyz, r3, v0
mov oC0, r3

=== vs11_psize
// SM1.1 VS: point sprites writing oPts (Nine's point-size min/max variant key)
vs_1_1
dcl_position v0
dcl_color v1
dcl_psize v2
m4x4 oPos, v0, c0
mov oD0, v1
mul oPts, v2.x, c4.x

=== ps14_cnd_multitex
// SM1.4 PS: two phases, texld/texcrd, cnd, dependent read (ps_1_x sampler types are a Nine variant key)
ps_1_4
def c2, 0.5, 0.5, 0.5, 0.5
texld r0, t0
texcrd r1.xyz, t1
phase
texld r2, r1
texld r3, t0
mul r4, r0, r2
cnd r0, r0.a, r4, r3
add r0.rgb, r0, c1

=== ps11_shadowproj
// SM1.1 PS: tex on four stages (D3DTTFF_PROJECTED and sampler types are ps < 1.4 variant keys)
ps_1_1
tex t0
tex t1
tex t2
tex t3
mul r0, t0, t1
mad r0, t2, c0, r0
mul r0, r0, t3

=== vs30_texldl_loop
// SM3.0 VS: vertex texture fetch (texldl), loop over aL with an integer constant, bool branch
vs_3_0
defi i0, 4, 0, 1, 0
def c90, 0.0, 1.0, 0.25, 0.0
dcl_position v0
dcl_texcoord v1
dcl_position o0
dcl_texcoord o1
dcl_2d s0
mov r1, c90.x
mov r2, v1
mov r2.zw, c90.x
texldl r3, r2, s0
loop aL, i0
add r1, r1, c[aL + 20]
endloop
if b0
mul r1, r1, c90.z
endif
mad r4, r3.x, c5, v0
m4x4 o0, r4, c0
add o1, v1, r1

=== ps30_vface_grad
// SM3.0 PS: vFace, vPos, dsx/dsy, texldd, dynamic if/else, break in a rep loop
ps_3_0
defi i0, 3, 0, 1, 0
def c10, 0.0, 1.0, 0.5, 0.001
dcl_texcoord0 v0.xy
dcl vFace
dcl vPos.xy
dcl_2d s0
dsx r0.xy, v0
dsy r1.xy, v0
texldd r2, v0, s0, r0, r1
mov r3, c10.x
rep i0
add r3, r3, r2
break_gt r3.x, c10.y
endrep
mul r5, r3, c10.z
mul r6, r3, c10.y
cmp r3, vFace, r6, r5
if_lt r3.x, c10.y
mul r3, r3, c10.z
else
add r3, r3, c10.w
endif
mul r4.xy, vPos, c10.w
add r3.xy, r3, r4
mov oC0, r3

=== vs20_flow_const
// SM2.0 VS: static flow on bool/int constants (if b, rep i) -> Nine's int/bool slot paths
vs_2_0
def c90, 0.0, 1.0, 0.0, 0.0
dcl_position v0
dcl_color v1
mov r0, v1
if b1
mul r0, r0, c4
endif
rep i1
add r0, r0, c5
endrep
m4x4 oPos, v0, c0
mov oD0, r0

=== vs20_callnz_nested
// SM2.0 VS: call, callnz on a bool constant, a subroutine calling another (nesting 2), labels after main
vs_2_0
def c90, 1.0, 0.5, 0.0, 2.0
dcl_position v0
dcl_normal v1
mov r0, c90.z
call l0
callnz l1, b0
m4x4 oPos, v0, c0
mov oD0, r0
ret
label l0
dp3 r0.x, v1, c4
call l2
ret
label l1
mul r0, r0, c90.y
ret
label l2
max r0.x, r0.x, c90.z
mov r0.w, c90.x
ret

=== vs20_call_rep
// SM2.0 VS: the subroutine holds a rep loop on an integer constant; called twice
vs_2_0
defi i1, 3, 0, 0, 0
def c90, 0.0, 1.0, 0.0, 0.0
dcl_position v0
mov r0, c90.x
call l3
call l3
m4x4 oPos, v0, c0
mov oD0, r0
ret
label l3
rep i1
add r0, r0, c5
endrep
ret

=== vs30_loop_call
// SM3.0 VS: call inside loop aL; the subroutine indexes constants with the caller's aL
vs_3_0
defi i0, 4, 0, 1, 0
def c90, 0.0, 1.0, 0.25, 0.0
dcl_position v0
dcl_position o0
dcl_color o1
mov r1, c90.x
loop aL, i0
call l0
endloop
m4x4 o0, v0, c0
mov o1, r1
ret
label l0
add r1, r1, c[aL + 20]
ret

=== ps30_callnz_pred
// SM3.0 PS: callnz on the predicate (and its negation); a subroutine with an if inside
ps_3_0
def c10, 0.5, 1.0, 0.0, 0.0
dcl_texcoord0 v0.xy
dcl_2d s0
texld r0, v0, s0
setp_gt p0.x, r0.x, c10.x
callnz l0, p0
callnz l1, !p0
mov oC0, r0
ret
label l0
mul r0, r0, c1
ret
label l1
if_gt r0.y, c10.x
add r0, r0, c2
endif
ret

=== vs20_call_recursive_xfail
// expected rejection: recursion is illegal in D3D9; the inliner stops at depth 8 with D3DERR_INVALIDCALL
// (names ending in _xfail must be rejected by Nine, not crash)
vs_2_0
dcl_position v0
call l0
m4x4 oPos, v0, c0
ret
label l0
call l0
ret

=== vs20_call_earlyret_xfail
// expected rejection: ret inside flow control of a subroutine has no inline form
vs_2_0
dcl_position v0
mov r0, c4
call l0
m4x4 oPos, v0, c0
mov oD0, r0
ret
label l0
if b0
ret
endif
mul r0, r0, c5
ret

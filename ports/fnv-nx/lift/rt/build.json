{
 "format": "fnvnx-recipe/1",
 "compiler": {
  "external": "gcc-msvcmodel",
  "cc": "bin/aarch64-linux-gnu-gcc",
  "cxx": "bin/aarch64-linux-gnu-g++"
 },
 "flags": {
  "c": [
   "-mabi=ilp32",
   "-O2",
   "-fPIC",
   "-ffreestanding",
   "-fno-stack-protector",
   "-fno-asynchronous-unwind-tables",
   "-fno-builtin",
   "-Werror=attributes"
  ],
  "cxx": [
   "-mabi=ilp32",
   "-std=gnu++17",
   "-O2",
   "-fms-extensions",
   "-fshort-wchar",
   "-frounding-math",
   "-fsigned-char",
   "-fno-strict-aliasing",
   "-fwrapv",
   "-fno-delete-null-pointer-checks",
   "-fcheck-new",
   "-fno-sized-deallocation",
   "-fno-lifetime-dse",
   "-ffp-contract=off",
   "-fPIC",
   "-fpermissive",
   "-march=armv8-a+crc+crypto",
   "-mtune=cortex-a57",
   "-fno-stack-protector",
   "-fno-stack-clash-protection",
   "-mno-outline-atomics",
   "-U_FORTIFY_SOURCE",
   "-ffreestanding",
   "-fno-exceptions",
   "-fno-asynchronous-unwind-tables",
   "-fno-math-errno",
   "-ffixed-x19",
   "-ffixed-x20",
   "-ffixed-x21",
   "-ffixed-x22",
   "-ffixed-x23",
   "-ffixed-x24",
   "-ffixed-x25",
   "-ffixed-x26",
   "-ffixed-x27",
   "-DFNVNX_SDD=1",
   "-fno-devirtualize",
   "-Werror=attributes"
  ],
  "asm": [
   "-mabi=ilp32",
   "-fPIC"
  ]
 },
 "include": [
  "ports/fnv-nx/lift/rt"
 ],
 "units": "all",
 "link": null,
 "plugin_cxx": "x86_64-linux-gnu-g++-13",
 "plugins": [

   "args": {}
  },
  {
   "name": "fnvnx_pi",
   "source": "ports/fnv-nx/toolchain/pi/fnvnx_pi.cc",
   "args": {}
  },
  {
   "name": "fnvnx_dispatch",
   "source": "ports/fnv-nx/toolchain/dispatch/fnvnx_dispatch.cc",
   "args": {}
  },
  {
   "name": "fnvnx_addr",
   "source": "ports/fnv-nx/toolchain/addr/fnvnx_addr.cc",
   "args": {}
  },
  {
   "name": "fnvnx_names",
   "source": "ports/fnv-nx/toolchain/names/fnvnx_names.cc",
   "args": {}
  },
  {
   "name": "fnvnx_layout",

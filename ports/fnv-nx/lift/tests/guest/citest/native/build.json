  },
  {
   "name": "fnvnx_pi"
  },
  {
   "name": "fnvnx_dispatch"
  },
  {
   "name": "fnvnx_addr"
  },
  {
   "name": "fnvnx_names"
  },
  {
   "name": "fnvnx_layout"
  }
 ],
 "external": [
  {
   "name": "gcc-msvcmodel",

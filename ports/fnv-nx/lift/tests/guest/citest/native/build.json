{
 "format": "fnvnx-recipe/1",
 "compiler": {
  "external": "gcc-msvcmodel",
  "cc": "bin/aarch64-linux-gnu-gcc",
  "cxx": "bin/aarch64-linux-gnu-g++"
 },
 "flags": {
  "c": [
   "-O2",
   "-Werror=attributes"
  ],
  "cxx": [
   "-std=gnu++17",
   "-O2",
   "-DFNVNX_SDD=1",
   "-Werror=attributes"
  ],
  "asm": []
 },
 "include": [
  "ports/fnv-nx/lift/rt",
  "ports/fnv-nx/shim/include"
 ],
 "units": "all",
 "uses": [

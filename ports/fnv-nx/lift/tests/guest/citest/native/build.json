  },
  {
   "root": "ports/fnv-nx/lift/rt",
   "output": "GEN"
  }
 ],
 "link": {
  "output": "citest.elf",
  "flags": [
   "-m",
   "aarch64linux32"
  ],
  "entry": "fnvl_citest_entry"
 },
 "plugins": [

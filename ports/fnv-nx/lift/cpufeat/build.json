{
 "format": "fnvnx-recipe/1",
 "external": [
  {
   "name": "sdm",
   "repo": "fnv-nx-build",
   "ref": "tools/intel-sdm",
   "commit": "0768b0baf29a625871084414338c12f65d0f2cc8",
   "tree_sha256": "07c5cdf925d7c929a81d0819a409667b212a307a89a90d5bdd04e1bf82e9b389",
   "at": "/ext/sdm"
  },
  {
   "name": "apm",
   "repo": "fnv-nx-build",
   "ref": "tools/amd-apm",
   "commit": "bd63d66d5cc81cd2f1beb7080747f5d06bc044c6",
   "tree_sha256": "9f37c7f84ad2d76b6f0b01e2772b562864f8965e7cace136763797d7ddc92b9c",
   "at": "/ext/apm"
  }
 ],
 "run": [
  {
   "name": "sdm",
   "exec": "/usr/bin/pdftotext",
   "args": [
    "-layout",
    "/in/1",
    "/out/sdm.txt"
   ],
   "inputs": [
    {
     "external": "sdm",
     "path": "intel-64-ia-32-sdm-combined.pdf"
    }
   ],
   "debs": {
    "closure": [
     "poppler-utils"
    ]
   },
   "outputs": [
    "sdm.txt"
   ]
  },
  {
   "name": "apm3",
   "exec": "/usr/bin/pdftotext",
   "args": [
    "-layout",
    "/in/1",
    "/out/apm3.txt"
   ],
   "inputs": [
    {
     "external": "apm",
     "path": "amd64-apm-vol3.pdf"
    }
   ],
   "debs": {
    "closure": [
     "poppler-utils"
    ]
   },
   "outputs": [
    "apm3.txt"
   ]
  },
  {
   "name": "apm5",
   "exec": "/usr/bin/pdftotext",
   "args": [
    "-layout",
    "/in/1",
    "/out/apm5.txt"
   ],
   "inputs": [
    {
     "external": "apm",
     "path": "amd64-apm-vol5.pdf"
    }
   ],
   "debs": {
    "closure": [
     "poppler-utils"
    ]
   },
   "outputs": [
    "apm5.txt"
   ]
  },
  {
   "name": "features",
   "exec": {
    "python": true
   },
   "args": [
    "/in/1",
    "--work",
    "/scratch/w",
    "--src",
    "proof/__init__.py=/in/2",
    "--src",
    "proof/sdmfeat.py=/in/3",
    "--src",
    "proof/vendormap.py=/in/4",
    "--sdm-pdf",
    "/in/5",
    "--sdm-txt",
    "/in/6",
    "--apm",
    "/in/7",
    "/in/8",
    "--apm",
    "/in/9",
    "/in/10",
    "features",
    "--out",
    "/out/cpuid_feature_bits.tsv"
   ],
   "inputs": [
    "ports/fnv-nx/lift/proof/cpufeat_stage.py",
    "ports/fnv-nx/lift/proof/__init__.py",
    "ports/fnv-nx/lift/proof/sdmfeat.py",
    "ports/fnv-nx/lift/proof/vendormap.py",
    {
     "external": "sdm",
     "path": "intel-64-ia-32-sdm-combined.pdf"
    },
    {
     "stage": "ports/fnv-nx/lift/cpufeat:run:sdm",
     "path": "sdm.txt"
    },
    {
     "external": "apm",
     "path": "amd64-apm-vol3.pdf"
    },
    {
     "stage": "ports/fnv-nx/lift/cpufeat:run:apm3",
     "path": "apm3.txt"
    },
    {
     "external": "apm",
     "path": "amd64-apm-vol5.pdf"
    },
    {
     "stage": "ports/fnv-nx/lift/cpufeat:run:apm5",
     "path": "apm5.txt"
    }
   ],
   "scratch": [
    "/scratch/w"
   ],
   "outputs": [
    "cpuid_feature_bits.tsv"
   ],
   "debs": []
  }
 ],
 "outputs": {
  "CPUFEAT": "cpuid_feature_bits.tsv"
 }
}
